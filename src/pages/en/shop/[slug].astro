---
import type { GetStaticPaths } from 'astro';
import CategoryView from '../../../components/views/CategoryView.astro';
import { loadCategories } from '../../../i18n/locale';

export const getStaticPaths = (async () =>
  (await loadCategories('fr')).map((item) => ({
    params: { slug: item.slug },
  }))) satisfies GetStaticPaths;
---

<CategoryView locale="en" slug={String(Astro.params.slug)} />
