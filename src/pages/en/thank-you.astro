---
import ThanksView from '../../cart/views/ThanksView.astro';
import Base from '../../layouts/Base.astro';
import { loadLocale } from '../../i18n/locale';

const locale = 'en' as const;
const t = await loadLocale(locale);
---

<Base {locale} routeKey="thanks" title={t.thanks.metaTitle} description={t.thanks.metaDescription}>
  <ThanksView {locale} {t} />
</Base>
