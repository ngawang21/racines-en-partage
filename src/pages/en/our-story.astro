---
import Base from '../../layouts/Base.astro';
import { loadPage } from '../../i18n/locale';

const locale = 'en' as const;
const page = await loadPage(locale, 'about');
---

<Base {locale} routeKey="about" title={page.seoTitle} description={page.seoDescription}>
  <section class="container section">
    <h1>{page.title}</h1>
    <p class="lead">{page.lead}</p>
  </section>
</Base>
