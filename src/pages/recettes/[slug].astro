---
import type { GetStaticPaths } from 'astro';
import RecipeView from '../../components/views/RecipeView.astro';
import { loadRecipes } from '../../i18n/locale';

export const getStaticPaths = (async () =>
  (await loadRecipes('fr')).map((item) => ({
    params: { slug: item.slug },
  }))) satisfies GetStaticPaths;
---

<RecipeView locale="fr" slug={String(Astro.params.slug)} />
