---
import Base from '../layouts/Base.astro';
import { loadLocale } from '../i18n/locale';

const locale = 'fr' as const;
const t = await loadLocale(locale);
---

<Base {locale} routeKey="cart" title={t.cart.metaTitle} description={t.cart.metaDescription}>
  <section class="container section">
    <h1>{t.cart.title}</h1>
  </section>
</Base>
