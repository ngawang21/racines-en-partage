---
import CartView from '../cart/views/CartView.astro';
import Base from '../layouts/Base.astro';
import { loadLocale, loadSettings } from '../i18n/locale';

const locale = 'fr' as const;
const [t, settings] = await Promise.all([loadLocale(locale), loadSettings()]);
---

<Base {locale} routeKey="cart" title={t.cart.metaTitle} description={t.cart.metaDescription}>
  <CartView {locale} {t} shopOpen={settings.shop.open} />
</Base>
