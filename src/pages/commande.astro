---
import CheckoutView from '../cart/views/CheckoutView.astro';
import Base from '../layouts/Base.astro';
import { loadLocale } from '../i18n/locale';

const locale = 'fr' as const;
const t = await loadLocale(locale);
---

<Base
  {locale}
  routeKey="checkout"
  title={t.checkout.metaTitle}
  description={t.checkout.metaDescription}
>
  <CheckoutView {locale} {t} />
</Base>
