---
// Thanks page (spec 5.4). The static shell is the neutral thank-you with the
// contact details; src/cart/page-thanks.ts reads ?session_id, fetches
// GET /api/orders/:id and fills the order (and clears the cart once paid).
import Icon from '../../components/Icon.astro';
import OrderDetails from './OrderDetails.astro';
import type { Locale } from '../../consts';
import type { LocaleContent } from '../../content/locale-schema';
import { phoneE164 } from '../../i18n/format';
import { displayPhone } from '../address';
import { loadSettings } from '../../i18n/locale';
import { routePath } from '../../i18n/routing';
import { pageStrings, serializeStrings } from '../strings';

interface Props {
  locale: Locale;
  t: LocaleContent;
}
const { locale, t } = Astro.props;
const settings = await loadSettings();
const { email, phone } = settings.brand;
// "Une question ? Écrivez à {email} ou appelez le {phone}." with real links.
const contactParts = t.thanks.nextContact.split(/(\{email\}|\{phone\})/);
---

<section class="container thanks" data-thanks aria-busy="true">
  <header class="thanks-head">
    <span class="thanks-mark" aria-hidden="true"><Icon name="flower" size={30} /></span>
    {
      /* Neutral until page-thanks.ts knows more (review 13): "Votre commande"
       while the order loads, "Merci pour votre commande" once it is found. */
    }
    <h1 class="rep-title" data-thanks-title>{t.thanks.titleNeutral}</h1>
    <p class="lead thanks-lead" data-thanks-lead>{t.thanks.neutral}</p>
    <p class="thanks-number" data-thanks-number hidden></p>
    <p class="thanks-loading" role="status" data-thanks-loading></p>
  </header>

  <OrderDetails {locale} {t} />

  <p class="thanks-contact">
    {
      contactParts.map((part) =>
        part === '{email}' ? (
          <a href={`mailto:${email}`}>{email}</a>
        ) : part === '{phone}' ? (
          <a href={`tel:${phoneE164(phone)}`}>{displayPhone(phone, locale)}</a>
        ) : (
          part
        ),
      )
    }
  </p>
  <div class="thanks-actions">
    <a class="btn btn-primary" href={routePath('shop', locale)}>{t.thanks.backToShop}</a>
    <a class="btn btn-secondary" href={routePath('cart', locale)} data-thanks-cart hidden>
      {t.thanks.backToCart}
    </a>
  </div>
</section>
<script type="application/json" id="rep-page-strings" set:html={serializeStrings(pageStrings(t))} />
