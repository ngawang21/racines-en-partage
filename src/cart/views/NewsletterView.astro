---
// Newsletter confirmation page (spec iteration 3, 2.2). The confirmation
// e-mail links here with ?t=<token>; src/forms/landing.ts shows the block
// whose data-landing-when names the state: `confirm` (a button posts the
// token to POST /api/newsletter/confirm), `ok`, `invalid` (no or a refused
// token, with the signup band to start again) or `disabled`. Without
// JavaScript the `initial` blocks stay: the lead and a note.
import Icon from '../../components/Icon.astro';
import NewsletterSignup from '../../components/forms/NewsletterSignup.astro';
import type { Locale } from '../../consts';
import type { LocaleContent } from '../../content/locale-schema';
import { loadSettings } from '../../i18n/locale';
import { routePath } from '../../i18n/routing';

interface Props {
  locale: Locale;
  t: LocaleContent;
}
const { locale, t } = Astro.props;
const settings = await loadSettings();
const l = t.forms.landing;
const { email } = settings.brand;
const noscript = t.forms.noscript.split(/(\{email\})/);
---

<div class="nl-landing" data-newsletter-landing>
  <section class="container nl-landing-head">
    <header class="thanks-head">
      <span class="thanks-mark" aria-hidden="true"><Icon name="mail" size={28} /></span>
      <h1 class="rep-title">{l.title}</h1>
      <p class="lead" data-landing-when="initial">{l.neutral}</p>
    </header>
    <noscript>
      <p class="form-noscript nl-status-narrow">
        {
          noscript.map((part) =>
            part === '{email}' ? <a href={`mailto:${email}`}>{email}</a> : part,
          )
        }
      </p>
    </noscript>
    <div class="nl-status is-confirm" data-landing-when="confirm" hidden>
      <div class="nl-confirm">
        <p>{l.confirmLead}</p>
        <button type="button" class="btn btn-primary" data-landing-confirm>{l.confirm}</button>
        <p class="form-status is-error" role="status" data-landing-error data-retry={l.retry}></p>
      </div>
    </div>
    <div class="nl-status is-ok" data-landing-when="ok" hidden>
      <span class="form-done-mark" aria-hidden="true"><Icon name="check" size={20} /></span>
      <div>
        <h2 class="nl-status-title" tabindex="-1" data-landing-focus>{l.okTitle}</h2>
        <p>{l.ok}</p>
      </div>
    </div>
    <div class="nl-status is-invalid" data-landing-when="invalid" hidden>
      <div>
        <h2 class="nl-status-title" tabindex="-1" data-landing-focus>{l.invalidTitle}</h2>
        <p>{l.invalid}</p>
      </div>
    </div>
    <div class="nl-status is-invalid" data-landing-when="disabled" hidden>
      <p tabindex="-1" data-landing-focus>{l.disabled}</p>
    </div>
    <div class="thanks-actions">
      <a class="btn btn-secondary" href={routePath('shop', locale)}>{l.toShop}</a>
    </div>
  </section>
  <div data-landing-when="initial invalid">
    <NewsletterSignup {locale} {t} {settings} variant="band" />
  </div>
</div>
