---
// A disclosure built on <details>: no script, keyboard and screen reader
// support from the browser. Used on the product page and the FAQ.
interface Props {
  title: string;
  open?: boolean;
  /** Fragment target inside the panel: a link to "#recipe" opens it (Chromium, Firefox). */
  id?: string;
  /** Heading level wrapping the summary text, for the document outline. */
  level?: 'h2' | 'h3';
  class?: string;
}
const { title, open = false, id, level = 'h3', class: className } = Astro.props;
const Heading = level;
---

<details class:list={['acc', className]} {open}>
  <summary>
    <Heading class="acc-title">{title}</Heading>
    <span class="acc-icon" aria-hidden="true"></span>
  </summary>
  <div class="acc-body">
    {id && <span class="acc-anchor" {id} />}
    <slot />
  </div>
</details>

<style>
  .acc {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .acc-title {
    font-family: var(--font-body);
    font-size: var(--fs-1);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
  }
  summary:hover .acc-title {
    text-decoration: underline;
    text-decoration-color: var(--kraft);
    text-underline-offset: 5px;
  }
  .acc-icon {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .acc-icon::before,
  .acc-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--forest);
    transform: translate(-50%, -50%);
    transition: transform 200ms var(--ease-out);
  }
  .acc-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .acc-icon {
    background: var(--paper);
  }
  details[open] .acc-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .acc-anchor {
    display: block;
    scroll-margin-top: calc(var(--header-h) + 72px);
  }
  .acc-body {
    padding-bottom: var(--space-6);
    color: var(--forest);
  }
  .acc-body :global(p + p),
  .acc-body :global(p + ul),
  .acc-body :global(ul + p),
  .acc-body :global(h4 + ol),
  .acc-body :global(h4 + ul) {
    margin-top: var(--space-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .acc-icon::before,
    .acc-icon::after {
      transition: none;
    }
  }
</style>
