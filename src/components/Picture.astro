---
// astro:assets <Picture> with the shop's size presets: AVIF and WebP (a
// preset may keep WebP only), responsive widths, explicit dimensions, lazy
// unless told otherwise.
import type { ImageMetadata } from 'astro';
import { Picture as AstroPicture } from 'astro:assets';
import { resolveAsset } from '../images';

export type PicturePreset = 'card' | 'hero' | 'gallery' | 'zoom' | 'thumb';

interface Props {
  /** A content path ("/src/assets/products/moringa-100.webp") or an imported image. */
  src: string | ImageMetadata;
  alt: string;
  preset: PicturePreset;
  /** Overrides the preset's sizes attribute. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

type Format = 'avif' | 'webp';

const PRESETS: Record<PicturePreset, { widths: number[]; sizes: string; formats?: Format[] }> = {
  // Product grid: 2 columns on phones, 3, 4, then 5 from 1600 px. The card
  // crop scales the photo up to about 1.22 times the card width (pouchCrop).
  card: {
    widths: [240, 360, 480, 640, 800],
    sizes:
      '(min-width: 1600px) 330px, (min-width: 1440px) 390px, (min-width: 1080px) 28vw, (min-width: 720px) 36vw, 54vw',
  },
  hero: {
    widths: [640, 960, 1280, 1600, 2000, 2400],
    sizes: '(min-width: 900px) 55vw, 100vw',
  },
  // The photographs are exported at 1600 x 2400 (scripts/photos.mjs); 1200
  // covers the product page on dense screens (about 650 CSS px wide).
  gallery: {
    widths: [480, 720, 960, 1200],
    // 7/5 product layout: about 650 px from 1440 px (thumbnails beside it).
    sizes: '(min-width: 1440px) 650px, (min-width: 900px) 45vw, 100vw',
  },
  // The gallery's larger view, fitted to the viewport. Capped at 1200: a
  // portrait photograph fitted to a 900 px tall screen is 600 CSS px wide, so
  // 1200 covers dense screens, and the label's small print (claims the site
  // does not repeat) stays out of reading range. WebP only, loaded on demand;
  // its widths are the gallery's own variants, nothing is encoded twice.
  zoom: {
    widths: [480, 720, 960, 1200],
    sizes: '100vw',
    formats: ['webp'],
  },
  thumb: {
    widths: [80, 120, 160, 240],
    sizes: '80px',
  },
};

const { src, alt, preset, sizes, loading = 'lazy', fetchpriority, class: className } = Astro.props;
const image = typeof src === 'string' ? resolveAsset(src) : src;
const config = PRESETS[preset];
const fitting = config.widths.filter((w) => w <= image.width);
const widths = fitting.length > 0 ? fitting : [image.width];
---

<AstroPicture
  src={image}
  {alt}
  {widths}
  sizes={sizes ?? config.sizes}
  formats={config.formats ?? ['avif', 'webp']}
  {loading}
  decoding="async"
  {fetchpriority}
  class={className}
/>
