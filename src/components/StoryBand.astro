---
// "Deux terres" band on forest (spec 5.4): the painted scene of the two lands
// from the logo, the story, and the lands of origin (the product origins, a
// unit test keeps them in line) on one side with Arnouville on the other. No
// kicker: the hero's slogan is the only one on the home page.
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  title: string;
  body: string;
  lands: { from: string[]; to: string };
  fromLabel: string;
  toLabel: string;
  image: ImageMetadata;
  imageAlt: string;
  link: { href: string; label: string };
}
const { title, body, lands, fromLabel, toLabel, image, imageAlt, link } = Astro.props;
---

<section class="band-forest story" aria-labelledby="story-title">
  <div class="container story-grid section">
    <div class="story-media">
      <div class="story-frame">
        <Picture
          src={image}
          preset="gallery"
          sizes="(min-width: 960px) 420px, 300px"
          alt={imageAlt}
        />
      </div>
    </div>
    <div class="story-copy">
      <h2 id="story-title">{title}</h2>
      <p class="story-body">{body}</p>

      <div class="lands">
        <div class="land">
          <p class="land-label">{fromLabel}</p>
          <ul role="list" class="land-list">
            {lands.from.map((l) => <li>{l}</li>)}
          </ul>
        </div>
        <div class="land-link" aria-hidden="true">
          <span class="land-line"></span>
          <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
            {
              [0, 72, 144, 216, 288].map((deg) => (
                <ellipse cx="12" cy="6.4" rx="3.1" ry="4.4" transform={`rotate(${deg} 12 12)`} />
              ))
            }
            <circle cx="12" cy="12" r="1.8" fill="var(--gold)"></circle>
          </svg>
          <span class="land-line"></span>
        </div>
        <div class="land land-home">
          <p class="land-label">{toLabel}</p>
          <p class="land-to">
            <Icon name="pin" size={18} />
            {lands.to}
          </p>
        </div>
      </div>

      <a class="link-arrow" href={link.href}>{link.label}</a>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .story-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
  /* The painting sits in a circle with a thin gold ring, like the label's
     medallion seen up close. */
  .story-media {
    display: flex;
    justify-content: flex-start;
  }
  .story-frame {
    overflow: hidden;
    width: min(100%, 420px);
    aspect-ratio: 1;
    padding: 10px;
    border: 1px solid rgba(201, 162, 74, 0.7);
    border-radius: 50%;
    background: var(--forest-2);
  }
  @media (max-width: 959px) {
    .story-frame {
      width: min(100%, 300px);
    }
  }
  .story-frame :global(picture),
  .story-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .story-frame :global(img) {
    border-radius: 50%;
    object-fit: cover;
  }
  .story-copy {
    container-type: inline-size;
  }
  h2 {
    font-size: var(--fs-5);
  }
  .story-body {
    margin-top: var(--space-6);
    max-width: 56ch;
    color: var(--cream-muted);
    font-size: var(--fs-1);
    line-height: 1.65;
  }
  /* The six lands hold on two lines: the origins get two thirds of the box,
     and a narrow column (phones, the 960 to 1200 px range) stacks the box. */
  .lands {
    display: grid;
    grid-template-columns: minmax(0, 2fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    margin-block: var(--space-8);
    padding: var(--space-6);
    border: 1px solid rgba(251, 246, 234, 0.16);
    border-radius: var(--radius-m);
  }
  .land-label {
    margin-bottom: var(--space-2);
    color: var(--gold);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .land-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
  }
  .land-list li {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.86rem + 0.6vw, 1.25rem);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .land-list li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }
  .land-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    align-self: stretch;
    color: var(--hibiscus);
  }
  .land-link svg {
    width: 20px;
    height: 20px;
    flex: none;
  }
  .land-line {
    flex: 1;
    width: 1px;
    background: rgba(201, 162, 74, 0.6);
  }
  .land-to {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: var(--fs-2);
  }
  .land-to :global(svg) {
    color: var(--gold);
  }
  @container (max-width: 560px) {
    .lands {
      grid-template-columns: 1fr;
      padding: var(--space-4) var(--space-4) var(--space-6);
    }
    .land-link {
      flex-direction: row;
    }
    .land-line {
      width: auto;
      height: 1px;
    }
  }
</style>
