---
// "Deux terres" band on forest (spec 5.4): the duo photo, the story, and the
// lands of origin on one side with Arnouville on the other.
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  lands: { from: string[]; to: string };
  fromLabel: string;
  toLabel: string;
  image: ImageMetadata;
  imageAlt: string;
  link: { href: string; label: string };
}
const { eyebrow, title, body, lands, fromLabel, toLabel, image, imageAlt, link } = Astro.props;
---

<section class="band-forest story" aria-labelledby="story-title">
  <div class="container story-grid section">
    <div class="story-media">
      <div class="story-frame">
        <Picture
          src={image}
          preset="gallery"
          sizes="(min-width: 960px) 460px, 100vw"
          alt={imageAlt}
        />
      </div>
    </div>
    <div class="story-copy">
      <p class="eyebrow story-eyebrow">{eyebrow}</p>
      <h2 id="story-title">{title}</h2>
      <p class="story-body">{body}</p>

      <div class="lands">
        <div class="land">
          <p class="land-label">{fromLabel}</p>
          <ul role="list" class="land-list">
            {lands.from.map((l) => <li>{l}</li>)}
          </ul>
        </div>
        <div class="land-link" aria-hidden="true">
          <span class="land-line"></span>
          <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
            {
              [0, 72, 144, 216, 288].map((deg) => (
                <ellipse cx="12" cy="6.4" rx="3.1" ry="4.4" transform={`rotate(${deg} 12 12)`} />
              ))
            }
            <circle cx="12" cy="12" r="1.8" fill="var(--gold)"></circle>
          </svg>
          <span class="land-line"></span>
        </div>
        <div class="land land-home">
          <p class="land-label">{toLabel}</p>
          <p class="land-to">
            <Icon name="pin" size={18} />
            {lands.to}
          </p>
        </div>
      </div>

      <a class="link-arrow" href={link.href}>
        {link.label}
        <Icon name="chevron" />
      </a>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .story-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
  .story-frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 460px;
    border: 1px solid rgba(201, 162, 74, 0.6);
    border-radius: var(--radius-l);
    background: var(--forest-2);
  }
  @media (max-width: 959px) {
    .story-frame {
      aspect-ratio: 4 / 3;
      max-width: none;
    }
    .story-frame :global(img) {
      object-position: 50% 82% !important;
    }
  }
  .story-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  .story-eyebrow {
    color: var(--gold);
  }
  h2 {
    margin-top: var(--space-3);
    font-size: var(--fs-5);
  }
  .story-body {
    margin-top: var(--space-6);
    max-width: 56ch;
    color: var(--cream-muted);
    font-size: var(--fs-1);
    line-height: 1.65;
  }
  .lands {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 0.8fr);
    align-items: center;
    gap: var(--space-4);
    margin-block: var(--space-8);
    padding: var(--space-6);
    border: 1px solid rgba(251, 246, 234, 0.16);
    border-radius: var(--radius-m);
  }
  .land-label {
    margin-bottom: var(--space-2);
    color: var(--gold);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .land-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 0;
  }
  .land-list li {
    font-family: var(--font-display);
    font-size: var(--fs-1);
  }
  .land-list {
    gap: 4px 18px;
  }
  .land-list li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .land-list li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }
  .land-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    align-self: stretch;
    color: var(--hibiscus);
  }
  .land-link svg {
    width: 20px;
    height: 20px;
    flex: none;
  }
  .land-line {
    flex: 1;
    width: 1px;
    background: rgba(201, 162, 74, 0.6);
  }
  .land-to {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: var(--fs-2);
  }
  .land-to :global(svg) {
    color: var(--gold);
  }
  @media (max-width: 520px) {
    .lands {
      grid-template-columns: 1fr;
      padding: var(--space-4) var(--space-4) var(--space-6);
    }
    .land-link {
      flex-direction: row;
    }
    .land-line {
      width: auto;
      height: 1px;
    }
  }
</style>
