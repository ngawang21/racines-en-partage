---
// Category tiles with the duo photos: 2 columns on phones, 4 on wide screens.
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Category } from '../content/schemas';
import { routePath } from '../i18n/routing';
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import { countLabel } from './storefront';

interface Props {
  categories: Category[];
  counts: Record<string, number>;
  locale: Locale;
  t: LocaleContent;
  headingLevel?: 'h2' | 'h3';
  /** Fade the tiles up on scroll, staggered (home page, reveal.ts). */
  reveal?: boolean;
}
const { categories, counts, locale, t, headingLevel = 'h3', reveal = false } = Astro.props;
const Heading = headingLevel;
---

<ul class="tiles" role="list">
  {
    categories.map((c) => (
      <li data-reveal={reveal ? '' : undefined}>
        <a class="tile lift" href={routePath('category', locale, c.slug)}>
          <span class="frame tile-media">
            <Picture
              src={c.image}
              alt=""
              preset="card"
              sizes="(min-width: 1080px) 280px, (min-width: 720px) 45vw, 50vw"
            />
          </span>
          <span class="tile-body">
            <Heading class="tile-title">{c.name}</Heading>
            <span class="tile-count">
              {countLabel(counts[c.slug] ?? 0, t, locale)}
              <Icon name="chevron" size={16} />
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
    margin: 0;
  }
  @media (min-width: 1080px) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-m);
    color: var(--forest);
    text-decoration: none;
  }
  .tile-media {
    isolation: isolate;
    transition:
      box-shadow 320ms var(--ease-out-strong),
      border-color 200ms ease;
  }
  .tile-media :global(img) {
    object-position: 50% 58%;
    transition: transform 400ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile.lift:hover {
      box-shadow: none;
    }
    .tile:hover .tile-media {
      border-color: var(--kraft-deep);
      box-shadow: var(--shadow-float);
    }
    .tile:hover .tile-media :global(img) {
      transform: scale(1.04);
    }
  }
  .tile-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4) 2px 0;
  }
  .tile-title {
    font-size: var(--fs-2);
    line-height: 1.2;
  }
  .tile-count {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink-2);
    font-size: var(--fs--1);
  }
  .tile-count :global(svg) {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) {
    .tile:hover .tile-title {
      text-decoration: underline;
      text-decoration-color: var(--kraft);
      text-decoration-thickness: 1px;
      text-underline-offset: 5px;
    }
    .tile:hover .tile-count :global(svg) {
      transform: translateX(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile-count :global(svg),
    .tile-media :global(img) {
      transition: none;
    }
    .tile:hover .tile-media :global(img) {
      transform: none;
    }
    .tile:hover .tile-count :global(svg) {
      transform: none;
    }
  }
</style>
