---
// Category page, both locales (spec 5.4): a compact head (title and intro;
// the category photo only serves as the share image, the cards are the
// pictures here), the shop's category chips as links (the current one
// selected) with the count, the grid, then links to the other categories.
import { DEFAULT_LOCALE, type Locale } from '../../consts';
import { formatFamilies, groupFormats } from '../../content/merge';
import Base from '../../layouts/Base.astro';
import { loadCategories, loadLocale, loadProducts, loadSettings } from '../../i18n/locale';
import { routePath, routeUrl } from '../../i18n/routing';
import { resolveAsset } from '../../images';
import Breadcrumbs from '../Breadcrumbs.astro';
import ProductGrid from '../ProductGrid.astro';
import { countLabel } from '../storefront';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const [t, categories, products, settings, allFr] = await Promise.all([
  loadLocale(locale),
  loadCategories(locale),
  loadProducts(locale),
  loadSettings(),
  loadProducts(DEFAULT_LOCALE),
]);
const category = categories.find((c) => c.slug === slug);
if (!category) throw new Error(`unknown category ${slug}`);
const listed = products.filter((p) => p.category === slug);
// One card per product family (ProductGrid): the counts count cards.
const groups = groupFormats(products, products, formatFamilies(allFr));
const counts: Record<string, number> = {};
for (const { lead } of groups) counts[lead.category] = (counts[lead.category] ?? 0) + 1;
const cards = counts[slug] ?? 0;
const chips = [
  { href: routePath('shop', locale), label: t.shop.all, count: groups.length, current: false },
  ...categories.map((c) => ({
    href: routePath('category', locale, c.slug),
    label: c.name,
    count: counts[c.slug] ?? 0,
    current: c.slug === slug,
  })),
];
const others = categories.filter((c) => c.slug !== slug);
---

<Base
  {locale}
  routeKey="category"
  {slug}
  title={category.seoTitle ?? category.name}
  description={category.seoDescription ?? category.intro}
  image={{ src: resolveAsset(category.image), alt: category.name }}
  graph={{
    breadcrumbs: [
      { name: t.nav.home, url: routeUrl('home', locale) },
      { name: t.nav.shop, url: routeUrl('shop', locale) },
      { name: category.name, url: routeUrl('category', locale, slug) },
    ],
    items: listed.map((p) => ({ name: p.name, url: routeUrl('product', locale, p.slug) })),
  }}
>
  <div class="container-wide page-head cat-head">
    <Breadcrumbs
      label={t.a11y.breadcrumb}
      items={[
        { name: t.nav.home, href: routePath('home', locale) },
        { name: t.nav.shop, href: routePath('shop', locale) },
        { name: category.name },
      ]}
    />
    <h1>{category.name}</h1>
    <p class="lead">{category.intro}</p>
  </div>

  <section class="container-wide cat-grid" aria-label={category.name}>
    <div class="cat-bar">
      <nav class="chips" aria-label={t.shop.categoriesNav}>
        {
          chips.map((c) => (
            <a class="chip" href={c.href} aria-current={c.current ? 'page' : undefined}>
              <span>{c.label}</span>
              <span class="chip-count" aria-hidden="true">
                {c.count}
              </span>
            </a>
          ))
        }
      </nav>
      <p class="cat-count">{countLabel(cards, t, locale)}</p>
    </div>
    {
      listed.length > 0 ? (
        <ProductGrid
          products={listed}
          {locale}
          {t}
          shopOpen={settings.shop.open}
          headingLevel="h2"
          eager={5}
          balance
        />
      ) : (
        <p class="empty">{t.shop.empty}</p>
      )
    }
  </section>

  <nav class="container-wide others" aria-labelledby="others-title">
    <h2 id="others-title" class="others-title">{t.shop.otherCategories}</h2>
    <ul role="list">
      {
        others.map((c) => (
          <li>
            <a class="other" href={routePath('category', locale, c.slug)}>
              {c.name}
            </a>
          </li>
        ))
      }
      <li>
        <a class="other other-all" href={routePath('shop', locale)}>{t.shop.viewAll}</a>
      </li>
    </ul>
  </nav>
</Base>

<style>
  /* Compact head, as on the shop page: a full row of cards above the fold. */
  .cat-head {
    padding-block: 20px var(--space-6);
  }
  .cat-head :global(.crumbs) {
    margin-bottom: var(--space-3);
  }
  .cat-head h1 {
    font-size: clamp(2.25rem, 1.9rem + 1.2vw, 3rem);
    line-height: 1.05;
  }
  .cat-head .lead {
    max-width: 72ch;
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  /* The shop's chip row (global .chips), the count at its end, as on the
     shop page. */
  .cat-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .cat-bar .chips {
    flex: 0 0 calc(100% + 2 * var(--gutter));
    min-width: 0;
  }
  @media (min-width: 900px) {
    .cat-bar .chips {
      flex: 1 1 auto;
    }
  }
  .cat-count {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs--1);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cat-grid :global(.product-grid) {
    margin-top: 20px;
  }
  .empty {
    padding-block: var(--space-12);
    color: var(--ink-2);
    text-align: center;
  }
  .others {
    padding-block: clamp(3rem, 2rem + 4.5vw, 6rem) 0;
  }
  .others-title {
    margin-bottom: var(--space-4);
    font-size: var(--fs-3);
  }
  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .other {
    touch-action: manipulation;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.5);
    color: var(--forest);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out-strong);
  }
  @media (hover: hover) {
    .other:hover {
      border-color: var(--kraft-deep);
      background: var(--cream);
    }
  }
  .other:active {
    transform: scale(0.97);
  }
  .other-all {
    border-color: var(--forest);
  }
</style>
