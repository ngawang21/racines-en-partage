---
// Category page, both locales (spec 5.4): intro, category photo, the grid,
// then links to the other categories.
import type { Locale } from '../../consts';
import Base from '../../layouts/Base.astro';
import { loadCategories, loadLocale, loadProducts, loadSettings } from '../../i18n/locale';
import { routePath, routeUrl } from '../../i18n/routing';
import { resolveAsset } from '../../images';
import Breadcrumbs from '../Breadcrumbs.astro';
import Picture from '../Picture.astro';
import ProductGrid from '../ProductGrid.astro';
import { countLabel } from '../storefront';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const [t, categories, products, settings] = await Promise.all([
  loadLocale(locale),
  loadCategories(locale),
  loadProducts(locale),
  loadSettings(),
]);
const category = categories.find((c) => c.slug === slug);
if (!category) throw new Error(`unknown category ${slug}`);
const listed = products.filter((p) => p.category === slug);
const others = categories.filter((c) => c.slug !== slug);
---

<Base
  {locale}
  routeKey="category"
  {slug}
  title={category.seoTitle ?? category.name}
  description={category.seoDescription ?? category.intro}
  image={{ src: resolveAsset(category.image), alt: category.name }}
  graph={{
    breadcrumbs: [
      { name: t.nav.home, url: routeUrl('home', locale) },
      { name: t.nav.shop, url: routeUrl('shop', locale) },
      { name: category.name, url: routeUrl('category', locale, slug) },
    ],
    items: listed.map((p) => ({ name: p.name, url: routeUrl('product', locale, p.slug) })),
  }}
>
  <div class="container page-head cat-head">
    <div class="cat-copy">
      <Breadcrumbs
        label={t.a11y.breadcrumb}
        items={[
          { name: t.nav.home, href: routePath('home', locale) },
          { name: t.nav.shop, href: routePath('shop', locale) },
          { name: category.name },
        ]}
      />
      <p class="eyebrow">{t.shop.categoryKicker}</p>
      <h1>{category.name}</h1>
      <p class="lead">{category.intro}</p>
      <p class="cat-count">{countLabel(listed.length, t, locale)}</p>
    </div>
    <div class="cat-media">
      <Picture
        src={category.image}
        alt=""
        preset="gallery"
        sizes="(min-width: 900px) 420px, 100vw"
        loading="eager"
      />
    </div>
  </div>

  <section class="container cat-grid" aria-label={category.name}>
    {
      listed.length > 0 ? (
        <ProductGrid
          products={listed}
          {locale}
          {t}
          shopOpen={settings.shop.open}
          headingLevel="h2"
        />
      ) : (
        <p class="empty">{t.shop.empty}</p>
      )
    }
  </section>

  <nav class="container others" aria-labelledby="others-title">
    <h2 id="others-title" class="others-title">{t.shop.otherCategories}</h2>
    <ul role="list">
      {
        others.map((c) => (
          <li>
            <a class="other" href={routePath('category', locale, c.slug)}>
              {c.name}
            </a>
          </li>
        ))
      }
      <li>
        <a class="other other-all" href={routePath('shop', locale)}>{t.shop.viewAll}</a>
      </li>
    </ul>
  </nav>
</Base>

<style>
  .cat-head {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .cat-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-16);
    }
  }
  .cat-copy :global(.crumbs) {
    margin-bottom: var(--space-6);
  }
  .cat-copy .eyebrow {
    margin-bottom: var(--space-3);
  }
  .cat-count {
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--fs--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cat-media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--kraft);
    border-radius: var(--radius-l);
    background: var(--paper);
  }
  @media (min-width: 900px) {
    .cat-media {
      aspect-ratio: 4 / 5;
    }
  }
  .cat-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }
  .cat-grid {
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .empty {
    padding-block: var(--space-12);
    color: var(--ink-2);
    text-align: center;
  }
  .others {
    padding-block: clamp(3rem, 2rem + 4.5vw, 6rem) 0;
  }
  .others-title {
    margin-bottom: var(--space-4);
    font-size: var(--fs-3);
  }
  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .other {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.5);
    color: var(--forest);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .other:hover {
    border-color: var(--kraft-deep);
  }
  .other-all {
    border-color: var(--forest);
  }
</style>
