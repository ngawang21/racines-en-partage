---
// Home page, both locales (spec 5.4).
import duoMoringa from '../../assets/brand/duo-moringa.webp';
import type { Locale } from '../../consts';
import Base from '../../layouts/Base.astro';
import {
  loadCategories,
  loadLocale,
  loadPage,
  loadProducts,
  loadReviews,
  loadSettings,
} from '../../i18n/locale';
import { routePath } from '../../i18n/routing';
import CategoryTiles from '../CategoryTiles.astro';
import Commitment from '../Commitment.astro';
import Hero from '../Hero.astro';
import HowItWorks from '../HowItWorks.astro';
import Ornament from '../Ornament.astro';
import ProductGrid from '../ProductGrid.astro';
import Reassurance from '../Reassurance.astro';
import RecipeCards from '../RecipeCards.astro';
import ReviewsBand from '../ReviewsBand.astro';
import SectionHead from '../SectionHead.astro';
import StoryBand from '../StoryBand.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [t, home, products, categories, settings, reviews] = await Promise.all([
  loadLocale(locale),
  loadPage(locale, 'home'),
  loadProducts(locale),
  loadCategories(locale),
  loadSettings(),
  loadReviews(),
]);
// Up to five: the grid shows as many as fill whole rows (see the styles).
const featured = products.filter((p) => p.featured).slice(0, 5);
const bySlug = new Map(products.map((p) => [p.slug, p]));
const recipeProducts = home.recipeProducts
  .map((slug) => bySlug.get(slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);
const counts: Record<string, number> = {};
for (const p of products) counts[p.category] = (counts[p.category] ?? 0) + 1;
const shopHref = routePath('shop', locale);
const aboutHref = routePath('about', locale);
---

<Base {locale} routeKey="home" title={home.seoTitle} description={home.seoDescription}>
  <Hero hero={home.hero} primaryHref={shopHref} secondaryHref={aboutHref} />
  <div class="kente" aria-hidden="true"></div>
  <Reassurance items={home.reassurance} />

  <section class="container-wide section featured" aria-labelledby="featured-title">
    <SectionHead
      id="featured-title"
      title={home.featuredTitle}
      eyebrow={t.nav.shop}
      link={{ href: shopHref, label: t.shop.viewAll }}
      reveal
    />
    <ProductGrid
      products={featured}
      {locale}
      {t}
      shopOpen={settings.shop.open}
      class="featured-grid"
      reveal
    />
  </section>

  <HowItWorks {t} reveal />

  <StoryBand
    eyebrow={t.nav.about}
    title={home.storyTitle}
    body={home.storyBody}
    lands={home.storyLands}
    fromLabel={t.shop.landsFrom}
    toLabel={t.shop.landsTo}
    image={duoMoringa}
    imageAlt=""
    link={{ href: aboutHref, label: home.hero.cta.secondary }}
  />

  {settings.reviews.enabled && <ReviewsBand {reviews} {products} {locale} {t} reveal />}

  <section class="container section" aria-labelledby="categories-title">
    <SectionHead id="categories-title" title={home.categoriesTitle} eyebrow={t.nav.shop} reveal />
    <CategoryTiles {categories} {counts} {locale} {t} reveal />
  </section>

  <div class="container">
    <Ornament />
  </div>

  <section class="container section" aria-labelledby="recipes-title">
    <SectionHead
      id="recipes-title"
      title={home.recipesTitle}
      eyebrow={t.shop.recipesKicker}
      link={{ href: routePath('recipes', locale), label: t.recipes.viewAll }}
      reveal
    />
    <RecipeCards products={recipeProducts} {locale} {t} reveal />
  </section>

  <Commitment
    title={home.commitmentTitle}
    body={home.commitmentBody}
    medallionAlt={t.a11y.medallionAlt}
    link={{ href: aboutHref, label: home.hero.cta.secondary }}
  />
</Base>

<script>
  import '../reveal';
</script>

<style>
  /* The home selection never leaves a lone card on its last row: three cards
     in the three-column range, four from 1080 px, five from 1600 px when the
     owner features five (four columns otherwise). */
  @media (min-width: 720px) and (max-width: 1079px) {
    .featured :global(.featured-grid > li:nth-child(n + 4)) {
      display: none;
    }
  }
  @media (min-width: 1080px) and (max-width: 1599px) {
    .featured :global(.featured-grid > li:nth-child(n + 5)) {
      display: none;
    }
  }
  @media (min-width: 1600px) {
    .featured :global(.featured-grid:not(:has(> li:nth-child(5)))) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 719px) {
    .featured :global(.featured-grid > li:nth-child(n + 5)) {
      display: none;
    }
  }
</style>
