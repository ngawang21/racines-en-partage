---
// Recipes page, both locales (spec 2.8): every recipe printed on a label, as
// a card linking to the product's recipe, then the newsletter band. Seo.astro
// adds one schema.org Recipe per card (graph kind "recipes").
import type { Locale } from '../../consts';
import Base from '../../layouts/Base.astro';
import { loadLocale, loadSettings } from '../../i18n/locale';
import { routePath, routeUrl } from '../../i18n/routing';
import Breadcrumbs from '../Breadcrumbs.astro';
import RecipeCards from '../RecipeCards.astro';
import NewsletterSignup from '../forms/NewsletterSignup.astro';
import { loadRecipes } from '../recipes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [t, settings, recipes] = await Promise.all([
  loadLocale(locale),
  loadSettings(),
  loadRecipes(locale),
]);
---

<Base
  {locale}
  routeKey="recipes"
  title={t.recipes.metaTitle}
  description={t.recipes.metaDescription}
  graph={{
    kind: 'recipes',
    breadcrumbs: [
      { name: t.nav.home, url: routeUrl('home', locale) },
      { name: t.recipes.title, url: routeUrl('recipes', locale) },
    ],
  }}
>
  <div class="container page-head">
    <Breadcrumbs
      label={t.a11y.breadcrumb}
      items={[{ name: t.nav.home, href: routePath('home', locale) }, { name: t.recipes.title }]}
    />
    <p class="eyebrow">{t.shop.recipesKicker}</p>
    <h1>{t.recipes.title}</h1>
    <p class="lead">{t.recipes.intro}</p>
  </div>

  <section class="container recipes-page" aria-labelledby="recipes-list-title">
    <h2 id="recipes-list-title" class="visually-hidden">{t.recipes.title}</h2>
    {
      recipes.length > 0 ? (
        <RecipeCards
          products={recipes.map((r) => r.product)}
          {locale}
          {t}
          layout="grid"
          headingLevel="h3"
        />
      ) : (
        <p class="empty">{t.recipes.empty}</p>
      )
    }
  </section>

  <NewsletterSignup {locale} {t} {settings} variant="band" />
</Base>

<style>
  .page-head .eyebrow + h1 {
    margin-top: var(--space-3);
  }
  .recipes-page {
    padding-bottom: clamp(3rem, 2rem + 4.5vw, 6rem);
  }
  .empty {
    color: var(--ink-2);
  }
</style>
