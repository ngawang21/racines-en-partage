---
// Recipes page, both locales: every recipe as a card linking to its own page
// (RecipeCards), then the newsletter band. The structured data lists the
// recipe pages (an ItemList of links); each recipe page carries its Recipe.
import type { Locale } from '../../consts';
import Base from '../../layouts/Base.astro';
import { loadLocale, loadProducts, loadRecipes, loadSettings } from '../../i18n/locale';
import { routePath, routeUrl } from '../../i18n/routing';
import Breadcrumbs from '../Breadcrumbs.astro';
import RecipeCards from '../RecipeCards.astro';
import NewsletterSignup from '../forms/NewsletterSignup.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [t, settings, recipes, products] = await Promise.all([
  loadLocale(locale),
  loadSettings(),
  loadRecipes(locale),
  loadProducts(locale),
]);
const bySlug = new Map(products.map((p) => [p.slug, p]));
---

<Base
  {locale}
  routeKey="recipes"
  title={t.recipes.metaTitle}
  description={t.recipes.metaDescription}
  graph={{
    kind: 'recipes',
    breadcrumbs: [
      { name: t.nav.home, url: routeUrl('home', locale) },
      { name: t.recipes.title, url: routeUrl('recipes', locale) },
    ],
    items: recipes.map((r) => ({ name: r.title, url: routeUrl('recipe', locale, r.slug) })),
  }}
>
  <div class="container page-head">
    <Breadcrumbs
      label={t.a11y.breadcrumb}
      items={[{ name: t.nav.home, href: routePath('home', locale) }, { name: t.recipes.title }]}
    />
    <h1>{t.recipes.title}</h1>
    <p class="lead">{t.recipes.intro}</p>
  </div>

  <section class="container recipes-page" aria-labelledby="recipes-list-title">
    <h2 id="recipes-list-title" class="visually-hidden">{t.recipes.title}</h2>
    {
      recipes.length > 0 ? (
        <RecipeCards
          items={recipes.map((recipe) => ({ recipe, product: bySlug.get(recipe.product) }))}
          {locale}
          {t}
          layout="grid"
          headingLevel="h3"
          eager={3}
        />
      ) : (
        <p class="empty">{t.recipes.empty}</p>
      )
    }
  </section>

  <NewsletterSignup {locale} {t} {settings} variant="band" />
</Base>

<style>
  .recipes-page {
    padding-bottom: clamp(3rem, 2rem + 4.5vw, 6rem);
  }
  .empty {
    color: var(--ink-2);
  }
</style>
