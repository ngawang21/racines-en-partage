---
// "Notre histoire", both locales (spec 5.4): the title and lead beside the
// painted medallion in a gold-ringed circle (no wordmark: the header already
// carries it), the story in sections (alternating photo and text, no
// numbering: they are not a sequence), then the slogan and a way to the shop.
import medallion from '../../assets/brand/medallion.webp';
import type { Locale } from '../../consts';
import Base from '../../layouts/Base.astro';
import { loadLocale, loadPage, loadSettings } from '../../i18n/locale';
import { pickLabel } from '../../i18n/fallback';
import { routePath } from '../../i18n/routing';
import Breadcrumbs from '../Breadcrumbs.astro';
import Ornament from '../Ornament.astro';
import Picture from '../Picture.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [t, page, home, settings] = await Promise.all([
  loadLocale(locale),
  loadPage(locale, 'about'),
  loadPage(locale, 'home'),
  loadSettings(),
]);
---

<Base {locale} routeKey="about" title={page.seoTitle} description={page.seoDescription}>
  <div class="container page-head about-head">
    <div>
      <Breadcrumbs
        label={t.a11y.breadcrumb}
        items={[{ name: t.nav.home, href: routePath('home', locale) }, { name: page.title }]}
      />
      <h1>{page.title}</h1>
      <p class="lead">{page.lead}</p>
    </div>
    <div class="about-medallion">
      <Picture
        src={medallion}
        alt={t.a11y.medallionAlt}
        preset="gallery"
        sizes="(min-width: 900px) 216px, 164px"
        loading="eager"
      />
    </div>
  </div>

  <div class="container">
    <Ornament />
  </div>

  <div class="container sections">
    {
      page.sections.map((s, i) => (
        <section class:list={['story', { 'has-image': s.image, flip: i % 4 === 2 }]}>
          {s.image && (
            <div class="story-media">
              <Picture
                src={s.image}
                alt={s.imageAlt ?? ''}
                preset="gallery"
                sizes="(min-width: 900px) 520px, 100vw"
              />
            </div>
          )}
          <div class="story-copy">
            <h2>{s.title}</h2>
            <p class="story-body">{s.body}</p>
          </div>
        </section>
      ))
    }
  </div>

  <section class="band-forest cta" aria-labelledby="about-cta">
    <div class="container section cta-inner">
      <h2 id="about-cta" class="cta-title">{pickLabel(settings.brand.tagline, locale)}</h2>
      <a class="btn btn-primary" href={routePath('shop', locale)}>{home.hero.cta.primary}</a>
    </div>
  </section>
</Base>

<style>
  /* Phones: title and lead first, the medallion after them (180 px), so the
     first screen reads as a page, not a badge. From 900 px: side by side. */
  .about-head {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-16);
    }
  }
  .about-head :global(.crumbs) {
    margin-bottom: var(--space-6);
  }
  /* The painting in a circle with a thin gold ring, as on the home story
     band. */
  .about-medallion {
    justify-self: start;
    overflow: hidden;
    width: 180px;
    aspect-ratio: 1;
    padding: 8px;
    border: 1px solid rgba(201, 162, 74, 0.7);
    border-radius: 50%;
    background: var(--paper);
  }
  @media (min-width: 900px) {
    .about-medallion {
      width: 232px;
      margin-right: var(--space-8);
    }
  }
  .about-medallion :global(picture),
  .about-medallion :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .about-medallion :global(img) {
    border-radius: 50%;
    object-fit: cover;
  }
  .sections {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    padding-block: clamp(3rem, 2rem + 4.5vw, 6rem);
  }
  .story {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .story:not(.has-image) .story-copy {
    max-width: 680px;
  }
  @media (min-width: 900px) {
    .story.has-image {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-16);
    }
    .story.flip .story-media {
      order: 2;
    }
  }
  .story-media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--kraft);
    border-radius: var(--radius-l);
    background: var(--paper);
  }
  .story.has-image:not(.flip) .story-media {
    aspect-ratio: 3 / 2;
  }
  .story.flip .story-media {
    aspect-ratio: 5 / 4;
  }
  /* The duo photo is a 2:3 portrait with the pouches in its middle half. */
  .story.flip .story-media :global(img) {
    object-position: 50% 48%;
  }
  .story-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }
  h2 {
    font-size: var(--fs-4);
  }
  .story-body {
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--fs-1);
    line-height: 1.7;
  }
  .cta-inner {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }
  .cta-title {
    max-width: 20ch;
    font-size: var(--fs-5);
  }
</style>
