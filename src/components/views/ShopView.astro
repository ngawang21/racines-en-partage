---
// Shop page, both locales (spec 5.4): category chips, sort select and the
// full grid. The grid is complete without JavaScript; shop-filter.ts filters
// and sorts the rendered cards and mirrors the state in the URL hash.
import { DEFAULT_LOCALE, type Locale } from '../../consts';
import { featuredFirst, formatFamilies, groupFormats } from '../../content/merge';
import Base from '../../layouts/Base.astro';
import { loadCategories, loadLocale, loadProducts, loadSettings } from '../../i18n/locale';
import { routePath, routeUrl } from '../../i18n/routing';
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon from '../Icon.astro';
import ProductGrid from '../ProductGrid.astro';
import { countLabel } from '../storefront';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [t, categories, loaded, settings, allFr] = await Promise.all([
  loadLocale(locale),
  loadCategories(locale),
  loadProducts(locale),
  loadSettings(),
  loadProducts(DEFAULT_LOCALE),
]);
// Default order, "Nos incontournables": the home page selection first (the
// `featured` products, in catalogue order), then the rest of the catalogue
// (category, then the owner's "Réorganiser" position, then name). Each card
// keeps its position in data-order, which the sort script falls back to.
const products = featuredFirst(loaded);
// The grid shows one card per product family (ProductGrid); the counts count cards.
const groups = groupFormats(products, products, formatFamilies(allFr));
const counts: Record<string, number> = {};
for (const { lead } of groups) counts[lead.category] = (counts[lead.category] ?? 0) + 1;
const chips = [
  { value: 'all', label: t.shop.all, count: groups.length },
  ...categories.map((c) => ({ value: c.slug, label: c.name, count: counts[c.slug] ?? 0 })),
];
const sorts = [
  { value: 'featured', label: t.shop.sortFeatured },
  { value: 'price-asc', label: t.shop.sortPriceAsc },
  { value: 'price-desc', label: t.shop.sortPriceDesc },
  { value: 'name', label: t.shop.sortName },
];
---

<Base
  {locale}
  routeKey="shop"
  title={t.shop.metaTitle}
  description={t.shop.metaDescription}
  graph={{
    items: products.map((p) => ({ name: p.name, url: routeUrl('product', locale, p.slug) })),
  }}
>
  <div class="container-wide page-head shop-head">
    <Breadcrumbs
      label={t.a11y.breadcrumb}
      items={[{ name: t.nav.home, href: routePath('home', locale) }, { name: t.nav.shop }]}
    />
    <h1>{t.shop.title}</h1>
    <div class="shop-lead">
      <p class="lead">{t.shop.intro}</p>
      <a class="link-arrow head-link" href={routePath('recipes', locale)}>
        {t.shop.recipesLink}
        <Icon name="chevron" />
      </a>
    </div>
  </div>

  <section class="container-wide shop" aria-labelledby="shop-results">
    <noscript
      ><style is:inline>
        [data-shop-tools] {
          display: none !important;
        }
      </style></noscript
    >
    <div class="shop-bar">
      <div
        class="shop-tools"
        data-shop-tools
        data-count-one={t.shop.countOne.replace('{count}', '%n')}
        data-count-many={t.shop.countMany.replace('{count}', '%n')}
        data-locale={locale}
      >
        <div class="chips" role="group" aria-label={t.shop.filterLabel}>
          {
            chips.map((c, i) => (
              <button
                type="button"
                class="chip"
                data-filter={c.value}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span>{c.label}</span>
                <span class="chip-count" aria-hidden="true">
                  {c.count}
                </span>
              </button>
            ))
          }
        </div>
        <div class="sort">
          <label for="shop-sort">{t.shop.sortLabel}</label>
          <div class="select">
            <select id="shop-sort" data-sort>
              {sorts.map((s) => <option value={s.value}>{s.label}</option>)}
            </select>
          </div>
        </div>
      </div>
      <p id="shop-results" class="count" aria-live="polite" data-count>
        {countLabel(groups.length, t, locale)}
      </p>
    </div>

    <ProductGrid
      {products}
      {locale}
      {t}
      shopOpen={settings.shop.open}
      headingLevel="h2"
      eager={5}
      balance
    />
    <p class="empty" data-empty hidden>{t.shop.empty}</p>
  </section>
</Base>

<script>
  import '../../scripts/shop-filter';
</script>

<style>
  /* Compact head: at 1440 x 900 the grid starts near y = 300, so the first
     row's names, prices and add buttons sit above the fold (H1 at 40 px; from
     1200 px the lead and the recipes link share its line; the chips, count
     and sort on one line). */
  .shop-head {
    padding-block: var(--space-4) 20px;
  }
  @media (min-width: 1200px) {
    .shop-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-8);
    }
    .shop-head :global(.crumbs) {
      flex: 0 0 100%;
    }
    .shop-head .shop-lead {
      flex: 1 1 0;
      min-width: 0;
      margin-top: 0;
    }
  }
  .shop-head :global(.crumbs) {
    margin-bottom: var(--space-2);
  }
  .shop-head h1 {
    font-size: clamp(2.125rem, 1.75rem + 0.9vw, 2.5rem);
    line-height: 1.05;
  }
  .shop-lead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-6);
    margin-top: var(--space-1);
  }
  .shop-head .lead {
    flex: 1 1 32rem;
    max-width: 72ch;
    margin-top: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  @media (min-width: 1200px) {
    .shop-head .lead {
      max-width: none;
    }
  }
  .head-link {
    flex: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .shop {
    padding-bottom: clamp(3rem, 2rem + 4.5vw, 6rem);
  }
  /* Filter chips, the count and the sort on one row (the count keeps its
   place without JavaScript, when the tools are hidden). */
  .shop-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .shop-tools {
    display: contents;
  }
  /* Phones: the chips take a whole row, bleeding to the screen edges. */
  .shop-bar .chips {
    order: 1;
    flex: 0 0 calc(100% + 2 * var(--gutter));
    min-width: 0;
  }
  .shop-bar .count {
    order: 2;
  }
  .shop-bar .sort {
    order: 3;
    margin-left: auto;
  }
  @media (min-width: 900px) {
    .shop-bar .chips {
      flex: 1 1 auto;
    }
  }
  .sort {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .sort label {
    color: var(--ink-2);
    font-size: var(--fs--1);
    font-weight: 500;
    white-space: nowrap;
  }
  .select {
    position: relative;
  }
  .select::after {
    content: '';
    position: absolute;
    right: 16px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--forest);
    border-bottom: 1.5px solid var(--forest);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  select {
    min-height: 44px;
    padding: 0 40px 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.6);
    color: var(--forest);
    font-size: 0.9375rem;
    font-weight: 500;
    appearance: none;
    cursor: pointer;
  }
  select {
    transition: border-color var(--dur-fast) ease;
  }
  @media (hover: hover) {
    select:hover {
      border-color: var(--kraft-deep);
    }
  }
  .count {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs--1);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .shop :global(.product-grid) {
    margin-top: 20px;
  }
  .empty {
    padding-block: var(--space-12);
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: var(--fs-2);
    font-style: italic;
    text-align: center;
  }
  :global([data-product-item][hidden]) {
    display: none;
  }
</style>
