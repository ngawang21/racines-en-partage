---
// Product page, both locales (spec 5.4).
import { getImage } from 'astro:assets';
import { SITE, type Locale } from '../../consts';
import type { Product } from '../../content/schemas';
import Base from '../../layouts/Base.astro';
import { formatPrice, formatWeight, toCents } from '../../i18n/format';
import { interpolate } from '../../i18n/fallback';
import {
  loadCategories,
  loadLocale,
  loadProduct,
  loadProducts,
  loadSettings,
} from '../../i18n/locale';
import { routePath, routeUrl } from '../../i18n/routing';
import { resolveAsset } from '../../images';
import { productGraphInput } from '../../seo/graph';
import Accordion from '../Accordion.astro';
import AddToCart from '../AddToCart.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Gallery from '../Gallery.astro';
import Icon from '../Icon.astro';
import NutritionTable from '../NutritionTable.astro';
import ProductGrid from '../ProductGrid.astro';
import SectionHead from '../SectionHead.astro';
import { companionPhoto } from '../companion';
import { STOCK_CLASS, deliveryLine, flagEmoji, stockLabel } from '../storefront';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const [t, product, all, settings, categories] = await Promise.all([
  loadLocale(locale),
  loadProduct(locale, slug),
  loadProducts(locale),
  loadSettings(),
  loadCategories(locale),
]);
const category = categories.find((c) => c.slug === product.category);
const images = product.images.map(resolveAsset);
const imageUrls = await Promise.all(
  images.map(
    async (src) =>
      new URL(
        (await getImage({ src, width: Math.min(1200, src.width), format: 'webp' })).src,
        SITE.url,
      ).href,
  ),
);

const weight = formatWeight(product.weightGrams, locale);
// French sets a no-break space before the colon, English none.
const colon = locale === 'fr' ? '\u00a0:' : ':';
const cents = toCents(product.price);
const shopOpen = settings.shop.open;
const max = settings.shop.maxQuantityPerLine;
const buyable = shopOpen && product.stock !== 'out';
const qtyId = `qty-${product.sku.toLowerCase()}`;
const flag = flagEmoji(product.originCountryCode);
const delivery = deliveryLine(settings, t, locale);

const companion = companionPhoto(product.images[0]!);
const gallery = [
  ...product.images.map((src, i) => ({
    src,
    alt:
      i === 0
        ? `${product.name} ${weight}`
        : interpolate(t.product.imageOf, { n: i + 1, total: product.images.length }),
  })),
  ...(companion
    ? [{ src: companion, alt: interpolate(t.product.galleryDuo, { name: product.name }) }]
    : []),
];

// "Dans le même esprit": the related slugs, completed with the same category.
const bySlug = new Map(all.map((p) => [p.slug, p]));
const related: Product[] = product.related
  .map((s) => bySlug.get(s))
  .filter((p): p is Product => p !== undefined);
for (const p of all) {
  if (related.length >= 4) break;
  if (p.slug !== product.slug && p.category === product.category && !related.includes(p))
    related.push(p);
}

const paragraphs = product.description.split(/\n\s*\n/).filter(Boolean);
const shopHref = routePath('shop', locale);
---

<Base
  {locale}
  routeKey="product"
  {slug}
  title={product.seoTitle ?? product.name}
  description={product.seoDescription ?? product.tagline}
  image={images[0] && { src: images[0], alt: product.name }}
  graph={{
    breadcrumbs: [
      { name: t.nav.home, url: routeUrl('home', locale) },
      { name: t.nav.shop, url: routeUrl('shop', locale) },
      ...(category
        ? [{ name: category.name, url: routeUrl('category', locale, category.slug) }]
        : []),
      { name: product.name, url: routeUrl('product', locale, slug) },
    ],
    product: productGraphInput(product, settings, imageUrls, category?.name),
  }}
>
  <div class="container product">
    <Breadcrumbs
      label={t.a11y.breadcrumb}
      class="product-crumbs"
      items={[
        { name: t.nav.home, href: routePath('home', locale) },
        { name: t.nav.shop, href: shopHref },
        ...(category
          ? [{ name: category.name, href: routePath('category', locale, category.slug) }]
          : []),
        { name: product.name },
      ]}
    />

    <div class="product-layout">
      <div class="product-media">
        <Gallery images={gallery} label={t.product.gallery} thumbLabel={t.product.imageOf} />
      </div>

      <div class="product-info">
        {
          category && (
            <p class="eyebrow">
              <a href={routePath('category', locale, category.slug)}>{category.name}</a>
            </p>
          )
        }
        <h1>{product.name}</h1>
        <p class="tagline">{product.tagline}</p>

        <ul class="facts" role="list">
          <li class="tag">
            <span class="visually-hidden">{t.product.weight}{colon}</span>{' '}
            {weight}
          </li>
          <li class="tag">
            <span class="visually-hidden">{t.product.origin}{colon}</span>{' '}
            {flag && <span aria-hidden="true">{flag}</span>}
            {product.origin}
          </li>
        </ul>

        <div class="price-row">
          <p class="price product-price">{formatPrice(cents, locale)}</p>
          <p class:list={['badge', STOCK_CLASS[product.stock]]}>{stockLabel(product.stock, t)}</p>
        </div>

        <div class="buy">
          <div class="stepper" data-qty-stepper>
            <button
              type="button"
              data-qty-step="-1"
              aria-controls={qtyId}
              aria-label={t.product.decrease}
              disabled={!buyable}
            >
              <Icon name="minus" size={18} />
            </button>
            <label class="visually-hidden" for={qtyId}>{t.product.quantity}</label>
            <input
              id={qtyId}
              type="number"
              inputmode="numeric"
              data-qty-for={product.sku}
              min="1"
              max={String(max)}
              value="1"
              disabled={!buyable}
            />
            <button
              type="button"
              data-qty-step="1"
              aria-controls={qtyId}
              aria-label={t.product.increase}
              disabled={!buyable}
            >
              <Icon name="plus" size={18} />
            </button>
          </div>
          <AddToCart
            sku={product.sku}
            stock={product.stock}
            {shopOpen}
            label={t.product.addToCart}
            outLabel={t.product.stockOut}
            class="buy-add"
          />
        </div>

        <ul class="assurances" role="list">
          {
            delivery && (
              <li>
                <Icon name="truck" size={20} />
                <span>{delivery}</span>
              </li>
            )
          }
          <li>
            <Icon name="leaf" size={20} />
            <span>{t.product.packagedBy}</span>
          </li>
        </ul>

        <div class="description">
          <h2 class="visually-hidden">{t.product.description}</h2>
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        {
          product.benefits.length > 0 && (
            <div class="benefits">
              <h2 class="mini-title">{t.product.benefits}</h2>
              <ul role="list">
                {product.benefits.map((b) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="accordions">
          <Accordion title={t.product.ingredients} level="h2" open>
            <p>{product.ingredients}</p>
          </Accordion>
          <Accordion title={t.product.usage} level="h2">
            <ul class="bullets">{product.usage.map((u) => <li>{u}</li>)}</ul>
          </Accordion>
          {
            product.recipe && (
              <Accordion
                title={`${t.product.recipe}${locale === 'fr' ? '\u00a0: ' : ': '}${product.recipe.title}`}
                level="h2"
                id="recipe"
              >
                {product.recipe.ingredients && product.recipe.ingredients.length > 0 && (
                  <>
                    <h3 class="mini-title">{t.product.recipeIngredients}</h3>
                    <ul class="bullets">
                      {product.recipe.ingredients.map((i) => (
                        <li>{i}</li>
                      ))}
                    </ul>
                  </>
                )}
                <h3 class="mini-title">{t.product.recipeSteps}</h3>
                <ol class="steps">
                  {product.recipe.steps.map((s) => (
                    <li>{s}</li>
                  ))}
                </ol>
              </Accordion>
            )
          }
          {
            product.nutritionVerified && product.nutrition && (
              <Accordion title={t.product.nutrition} level="h2">
                <NutritionTable nutrition={product.nutrition} {locale} {t} />
              </Accordion>
            )
          }
          <Accordion title={t.product.storage} level="h2">
            <p>{product.storage}</p>
          </Accordion>
          {
            product.howMade && (
              <Accordion title={t.product.howMade} level="h2">
                <p>{product.howMade}</p>
              </Accordion>
            )
          }
        </div>

        {
          product.free_from.length > 0 && (
            <div class="free-from">
              <h2 class="mini-title">{t.product.freeFrom}</h2>
              <ul role="list">
                {product.free_from.map((f) => (
                  <li class="tag">
                    <Icon name="leaf" />
                    {t.product.freeFromLabels[f]}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="band-paper related" aria-labelledby="related-title">
        <div class="container section">
          <SectionHead
            id="related-title"
            title={t.product.related}
            link={{ href: shopHref, label: t.shop.viewAll }}
          />
          <ProductGrid products={related.slice(0, 4)} {locale} {t} {shopOpen} />
        </div>
      </section>
    )
  }

  <aside class="container footnote">
    <p>{t.product.disclaimer}</p>
  </aside>
</Base>

<style>
  .product {
    padding-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    padding-bottom: clamp(3rem, 2rem + 4.5vw, 6rem);
  }
  .product :global(.product-crumbs) {
    margin-bottom: var(--space-6);
  }
  .product-layout {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 900px) {
    .product-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 4vw, 5rem);
      align-items: start;
    }
    .product-media {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
  .product-info .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .product-info .eyebrow a:hover {
    color: var(--forest);
    text-decoration: underline;
  }
  h1 {
    margin-top: var(--space-3);
    font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.25rem);
    line-height: 1.05;
  }
  .tagline {
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: var(--fs-2);
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
  }
  .price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .product-price {
    font-size: clamp(2rem, 1.7rem + 1.2vw, 2.5rem);
    line-height: 1;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    height: 52px;
    border: 1px solid var(--kraft-deep);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.55);
  }
  .stepper button {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--forest);
  }
  .stepper button {
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out-strong);
  }
  @media (hover: hover) {
    .stepper button:hover:not(:disabled) {
      background: rgba(22, 58, 28, 0.06);
    }
  }
  .stepper button:active:not(:disabled, [aria-disabled='true']) {
    transform: scale(0.92);
  }
  .stepper button[aria-disabled='true'] {
    color: var(--ink-2);
    cursor: default;
  }
  .stepper button:disabled,
  .stepper input:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .stepper input {
    width: 44px;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--forest);
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .stepper input::-webkit-outer-spin-button,
  .stepper input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }
  .buy :global(.buy-add) {
    flex: 1 1 160px;
    min-height: 52px;
    font-size: 1.0625rem;
  }
  .assurances {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .assurances li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .assurances :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--leaf);
  }
  .description {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
    font-size: var(--fs-1);
    line-height: 1.65;
  }
  .description p + p {
    margin-top: var(--space-4);
  }
  .mini-title {
    margin-bottom: var(--space-3);
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .accordions :global(.acc-body) .mini-title {
    margin-top: var(--space-4);
  }
  .accordions :global(.acc-body) .mini-title:first-child {
    margin-top: 0;
  }
  .benefits {
    margin-top: var(--space-8);
  }
  .benefits ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .benefits li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .benefits :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--leaf);
  }
  .accordions {
    margin-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .bullets,
  .steps {
    margin: 0;
    padding-left: 1.2em;
  }
  .bullets li + li,
  .steps li + li {
    margin-top: var(--space-2);
  }
  .bullets li::marker {
    color: var(--gold);
  }
  .steps li::marker {
    color: var(--kraft-ink);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .free-from {
    margin-top: var(--space-8);
  }
  .free-from ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .related {
    border-top: 1px solid var(--kraft);
  }
  .footnote {
    padding-block: var(--space-8) 0;
  }
  .footnote p {
    max-width: 72ch;
    margin-inline: auto;
    color: var(--ink-2);
    font-size: var(--fs--1);
    text-align: center;
  }
</style>
