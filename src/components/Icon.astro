---
export type IconName =
  | 'cart'
  | 'menu'
  | 'close'
  | 'leaf'
  | 'truck'
  | 'pin'
  | 'lock'
  | 'shield'
  | 'check'
  | 'chevron'
  | 'minus'
  | 'plus'
  | 'flower'
  | 'phone'
  | 'mail'
  | 'instagram';

interface Props {
  name: IconName;
  class?: string;
  /** Pixel size of the square; CSS may override it. */
  size?: number;
}
const { name, class: className, size = 24 } = Astro.props;

const petal = (deg: number) =>
  `<ellipse cx="12" cy="6.6" rx="2.9" ry="4.1" transform="rotate(${deg} 12 12)"/>`;

// Stroke icons on a 24 px grid, one weight, coloured by currentColor. Always
// decorative: the control that holds one carries the accessible name.
const PATHS: Record<IconName, string> = {
  cart: '<path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  leaf: '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19c3-4 6-6.5 9.5-8.5"/>',
  truck:
    '<path d="M2.5 6.5h11v9.5h-11zM13.5 9.5h4.2l3 3.4V16h-7.2"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
  pin: '<path d="M12 21s7-6 7-11.5a7 7 0 0 0-14 0C5 15 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.4"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
  shield:
    '<path d="M12 3 4 6v6c0 4.6 3.4 7.8 8 9 4.6-1.2 8-4.4 8-9V6l-8-3z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  chevron: '<path d="m9 5 7 7-7 7"/>',
  minus: '<path d="M5 12h14"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  flower: `${[0, 72, 144, 216, 288].map(petal).join('')}<circle cx="12" cy="12" r="1.4"/><path d="M12 12l3.2-3.2"/>`,
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.7 2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
