---
// "Petites recettes": the recipes printed on the labels, each linking to its
// product page (the recipe accordion carries id="recipe"). Type-led cards on
// the paper ground, no photo: the pouch is already in the product cards, and
// the drink photos do not exist yet. A small hibiscus flower, the product as
// a kicker, the recipe title, two or three lines, then "Voir la recette".
// `layout="row"` (home) swipes on phones; `layout="grid"` (recipes page)
// wraps and adds the number of steps and ingredients.
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Product } from '../content/schemas';
import { interpolate } from '../i18n/fallback';
import { routePath } from '../i18n/routing';
import Icon from './Icon.astro';

interface Props {
  products: Product[];
  locale: Locale;
  t: LocaleContent;
  layout?: 'row' | 'grid';
  headingLevel?: 'h2' | 'h3';
}
const { products, locale, t, layout = 'row', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const withRecipe = products.filter((p) => p.recipe);
const plural = (n: number, one: string, many: string) =>
  interpolate((locale === 'fr' ? n <= 1 : n === 1) ? one : many, { count: n });
---

<ul class:list={['recipes', `recipes-${layout}`]} role="list">
  {
    withRecipe.map((p) => {
      const r = p.recipe!;
      const lines = (r.ingredients?.length ? r.ingredients : r.steps).slice(0, 3);
      return (
        <li>
          <article class="recipe">
            <span class="recipe-mark" aria-hidden="true">
              <Icon name="flower" size={20} />
            </span>
            <p class="recipe-kicker">{p.name}</p>
            <Heading class="recipe-title">
              <a href={`${routePath('product', locale, p.slug)}#recipe`}>{r.title}</a>
            </Heading>
            {layout === 'grid' && (
              <p class="recipe-meta">
                {plural(r.steps.length, t.recipes.stepsOne, t.recipes.stepsMany)}
                {r.ingredients && r.ingredients.length > 0 && (
                  <>
                    <span aria-hidden="true"> · </span>
                    <span class="visually-hidden">, </span>
                    {plural(
                      r.ingredients.length,
                      t.recipes.ingredientsOne,
                      t.recipes.ingredientsMany,
                    )}
                  </>
                )}
              </p>
            )}
            <ul class="recipe-lines">
              {lines.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
            <span class="recipe-cta" aria-hidden="true">
              {t.shop.recipeCta}
            </span>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  /* Phones: a swipeable row with the next card peeking in; each card keeps
     its own height (a short recipe does not stretch to the tallest). From
     760 px: three columns of equal height. */
  .recipes {
    display: grid;
    grid-auto-columns: min(82%, 340px);
    grid-auto-flow: column;
    align-items: start;
    gap: var(--space-4);
    margin: 0 calc(var(--gutter) * -1);
    /* Room for the focus ring inside the scroller. */
    padding: var(--space-2) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .recipes::-webkit-scrollbar {
    display: none;
  }
  .recipes > li {
    scroll-snap-align: start;
  }
  @media (min-width: 760px) {
    .recipes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-flow: row;
      align-items: stretch;
      gap: var(--space-6);
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }
  /* Recipes page: every recipe, one column on phones, then two and three. */
  .recipes-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: row;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    overflow: visible;
  }
  @media (min-width: 600px) {
    .recipes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      gap: var(--space-6);
    }
  }
  /* Three a row on six tracks, and a last row that is never a lone card or
     a gap: two leftovers share the row, one leftover pairs with the card
     before it (two rows of two). */
  @media (min-width: 960px) {
    .recipes-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .recipes-grid > li {
      grid-column: span 2;
    }
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(2),
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(2) ~ li,
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(4),
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(4) ~ li {
      grid-column: span 3;
    }
  }

  .recipe {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(var(--space-6), 1rem + 1.2vw, var(--space-8));
    border-radius: var(--radius-m);
    background: var(--paper);
  }
  .recipe-mark {
    display: inline-flex;
    color: var(--hibiscus);
  }
  .recipe-kicker {
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .recipe-title {
    margin-top: var(--space-2);
    font-size: var(--fs-3);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color 200ms ease;
  }
  .recipe-title a {
    color: inherit;
    text-decoration: none;
  }
  .recipe-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .recipe-title a:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .recipe:has(a:focus-visible) {
    outline: 3px solid var(--hibiscus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--cream);
  }
  .recipe-meta {
    margin-top: var(--space-2);
    color: var(--kraft-ink);
    font-size: var(--fs--1);
    font-weight: 600;
  }
  .recipe-lines {
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .recipe-lines li {
    position: relative;
    padding-left: 16px;
  }
  .recipe-lines li + li {
    margin-top: var(--space-2);
  }
  .recipe-lines li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }
  .recipe-cta {
    margin-top: auto;
    align-self: flex-start;
    color: var(--forest);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--kraft-deep);
    text-underline-offset: 6px;
    transition: text-decoration-color var(--dur-fast) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .recipe:hover .recipe-title {
      text-decoration-color: var(--kraft-deep);
    }
    .recipe:hover .recipe-cta {
      text-decoration-color: var(--forest);
    }
  }
</style>
