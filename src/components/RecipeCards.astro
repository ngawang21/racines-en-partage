---
// Recipe cards: the recipes page lists every recipe with them, a recipe page
// its "D'autres recettes". One card per recipe, the whole card links to the
// recipe page. The picture is the recipe photo, else the close-up of the
// product's contents (recipePicture), as a 2:1 band across the top; without
// either, a small hibiscus flower opens the card instead. Then the product
// name (it tells which pouch the recipe uses), the title, the summary, and
// one quiet line: the total time and whether the recipe comes from the label
// or from the house.
// `layout="grid"` (recipes page) wraps, one to three columns, and never
// leaves a lone card on the last row; `layout="row"` swipes on phones and
// shows three columns from 760 px.
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Product, RecipeEntry } from '../content/schemas';
import { routePath } from '../i18n/routing';
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import { recipePicture, totalTime } from './recipes';

interface Props {
  items: Array<{ recipe: RecipeEntry; product?: Product }>;
  locale: Locale;
  t: LocaleContent;
  layout?: 'row' | 'grid';
  headingLevel?: 'h2' | 'h3';
  /** Cards whose picture loads at once (the first row of the recipes page). */
  eager?: number;
}
const { items, locale, t, layout = 'row', headingLevel = 'h3', eager = 0 } = Astro.props;
const Heading = headingLevel;
const sizes =
  layout === 'grid'
    ? '(min-width: 1440px) 420px, (min-width: 960px) 30vw, (min-width: 600px) 46vw, 100vw'
    : '(min-width: 1440px) 420px, (min-width: 760px) 30vw, 82vw';
---

<ul class:list={['recipes', `recipes-${layout}`]} role="list">
  {
    items.map(({ recipe: r, product }, index) => {
      const picture = recipePicture(r, product);
      return (
        <li>
          <article class:list={['recipe', { 'has-picture': picture }]}>
            {picture ? (
              <div class="recipe-media">
                <Picture
                  src={picture.src}
                  alt=""
                  preset="card"
                  {sizes}
                  loading={index < eager ? 'eager' : 'lazy'}
                />
              </div>
            ) : (
              <span class="recipe-mark" aria-hidden="true">
                <Icon name="flower" size={20} />
              </span>
            )}
            <div class="recipe-body">
              {product && <p class="recipe-kicker">{product.name}</p>}
              <Heading class="recipe-title">
                <a href={routePath('recipe', locale, r.slug)}>{r.title}</a>
              </Heading>
              <p class="recipe-summary">{r.summary}</p>
              <p class="recipe-meta">
                <span>
                  <span class="visually-hidden">{t.recipes.totalTime} </span>
                  {totalTime(r, locale)}
                </span>
                <span aria-hidden="true"> · </span>
                <span class="visually-hidden">, </span>
                <span>{r.source === 'label' ? t.recipes.sourceLabel : t.recipes.sourceHouse}</span>
              </p>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  /* Phones: a swipeable row with the next card peeking in. From 760 px:
     three columns of equal height. */
  .recipes {
    display: grid;
    grid-auto-columns: min(82%, 340px);
    grid-auto-flow: column;
    align-items: stretch;
    gap: var(--space-4);
    margin: 0 calc(var(--gutter) * -1);
    /* Room for the focus ring inside the scroller. */
    padding: var(--space-2) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .recipes::-webkit-scrollbar {
    display: none;
  }
  .recipes > li {
    scroll-snap-align: start;
  }
  @media (min-width: 760px) {
    .recipes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-flow: row;
      gap: var(--space-6);
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }
  /* Recipes page: every recipe, one column on phones, then two and three. */
  .recipes-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: row;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    overflow: visible;
  }
  @media (min-width: 600px) {
    .recipes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  /* Three a row on six tracks, and a last row that is never a lone card or
     a gap: two leftovers share the row, one leftover pairs with the card
     before it (two rows of two). */
  @media (min-width: 960px) {
    .recipes-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: var(--space-8);
    }
    .recipes-grid > li {
      grid-column: span 2;
    }
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(2),
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(2) ~ li,
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(4),
    .recipes-grid > li:nth-child(3n + 1):nth-last-child(4) ~ li {
      grid-column: span 3;
    }
  }

  .recipe {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--paper);
  }
  .recipe-media {
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--photo-ground);
  }
  .recipe-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .recipe-mark {
    display: inline-flex;
    padding: clamp(var(--space-6), 1rem + 1.2vw, var(--space-8))
      clamp(var(--space-6), 1rem + 1.2vw, var(--space-8)) 0;
    color: var(--hibiscus);
  }
  .recipe-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-4) clamp(var(--space-6), 1rem + 1.2vw, var(--space-8))
      clamp(var(--space-6), 1rem + 1.2vw, var(--space-8));
  }
  .has-picture .recipe-body {
    padding-top: var(--space-6);
  }
  .recipe-kicker {
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .recipe-title {
    margin-top: var(--space-2);
    font-size: var(--fs-3);
    line-height: 1.15;
    text-wrap: balance;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color 200ms ease;
  }
  .recipe-title a {
    color: inherit;
    text-decoration: none;
  }
  .recipe-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .recipe-title a:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .recipe:has(a:focus-visible) {
    outline: 3px solid var(--hibiscus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--cream);
  }
  .recipe-summary {
    margin: var(--space-3) 0 var(--space-6);
    max-width: 60ch;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .recipe-meta {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--kraft-ink);
    font-size: var(--fs--1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (hover: hover) and (pointer: fine) {
    .recipe:hover .recipe-title {
      text-decoration-color: var(--kraft-deep);
    }
  }
</style>
