---
// "Petites recettes": recipes printed on the labels, each linking to its
// product page (the recipe accordion carries id="recipe"). `layout="row"`
// (home) swipes on phones; `layout="grid"` (recipes page) wraps and adds the
// number of steps and ingredients.
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Product } from '../content/schemas';
import { interpolate } from '../i18n/fallback';
import { routePath } from '../i18n/routing';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  products: Product[];
  locale: Locale;
  t: LocaleContent;
  /** Fade the cards up on scroll, staggered (home page, reveal.ts). */
  reveal?: boolean;
  layout?: 'row' | 'grid';
  headingLevel?: 'h2' | 'h3';
}
const { products, locale, t, reveal = false, layout = 'row', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const withRecipe = products.filter((p) => p.recipe);
const plural = (n: number, one: string, many: string) =>
  interpolate((locale === 'fr' ? n <= 1 : n === 1) ? one : many, { count: n });
---

<ul class:list={['recipes', `recipes-${layout}`]} role="list">
  {
    withRecipe.map((p) => {
      const r = p.recipe!;
      const lines = (r.ingredients?.length ? r.ingredients : r.steps).slice(0, 3);
      return (
        <li data-reveal={reveal ? '' : undefined}>
          <article class="recipe lift">
            <div class="recipe-media">
              <Picture
                src={p.images[0]!}
                alt=""
                preset="card"
                sizes="(min-width: 960px) 380px, (min-width: 760px) 32vw, 82vw"
              />
            </div>
            <div class="recipe-body">
              <p class="recipe-kicker">{p.name}</p>
              <Heading class="recipe-title">
                <a href={`${routePath('product', locale, p.slug)}#recipe`}>{r.title}</a>
              </Heading>
              {layout === 'grid' && (
                <p class="recipe-meta">
                  {plural(r.steps.length, t.recipes.stepsOne, t.recipes.stepsMany)}
                  {r.ingredients && r.ingredients.length > 0 && (
                    <>
                      <span aria-hidden="true"> · </span>
                      <span class="visually-hidden">, </span>
                      {plural(
                        r.ingredients.length,
                        t.recipes.ingredientsOne,
                        t.recipes.ingredientsMany,
                      )}
                    </>
                  )}
                </p>
              )}
              <ul class="recipe-lines">
                {lines.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
              <span class="link-arrow recipe-cta" aria-hidden="true">
                {t.shop.recipeCta}
                <Icon name="chevron" />
              </span>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  /* Phones: a swipeable row with the next card peeking in, rather than three
     tall cards stacked. From 760 px: three columns. */
  .recipes {
    display: grid;
    grid-auto-columns: min(82%, 340px);
    grid-auto-flow: column;
    gap: var(--space-4);
    margin: 0 calc(var(--gutter) * -1);
    /* Room for the focus ring inside the scroller. */
    padding: var(--space-2) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .recipes::-webkit-scrollbar {
    display: none;
  }
  .recipes > li {
    scroll-snap-align: start;
  }
  @media (min-width: 760px) {
    .recipes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-flow: row;
      gap: var(--space-6);
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }
  /* Recipes page: every recipe, one column on phones, then two and three. */
  .recipes-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: row;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    overflow: visible;
  }
  @media (min-width: 600px) {
    .recipes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .recipes-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .recipe-meta {
    margin-top: var(--space-2);
    color: var(--kraft-ink);
    font-size: var(--fs--1);
    font-weight: 600;
  }
  .recipe {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--kraft);
    border-radius: var(--radius-m);
    background: var(--cream);
  }
  /* Square: the least a 2:3 portrait can be cropped to while keeping the
     whole pouch and what it holds. */
  .recipe-media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    isolation: isolate;
    background: var(--paper);
    border-bottom: 1px solid var(--kraft);
  }
  .recipe-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
    transition: transform 400ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .recipe.lift:hover {
      box-shadow: var(--shadow-float);
    }
    .recipe:hover .recipe-media :global(img) {
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .recipe-media :global(img) {
      transition: none;
    }
    .recipe:hover .recipe-media :global(img) {
      transform: none;
    }
  }
  .recipe-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(var(--space-4), 1rem + 1vw, var(--space-6));
  }
  .recipe-kicker {
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .recipe-title {
    margin-top: var(--space-2);
    font-size: var(--fs-3);
  }
  .recipe-title a {
    color: inherit;
    text-decoration: none;
  }
  .recipe-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .recipe-title a:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .recipe:has(a:focus-visible) {
    outline: 3px solid var(--hibiscus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--cream);
  }
  .recipe-lines {
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .recipe-lines li {
    position: relative;
    padding-left: 16px;
  }
  .recipe-lines li + li {
    margin-top: var(--space-2);
  }
  .recipe-lines li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }
  .recipe-cta {
    margin-top: auto;
    min-height: 0;
  }
  .recipe-title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color 200ms ease;
  }
  @media (hover: hover) {
    .recipe:hover .recipe-title {
      text-decoration-color: var(--kraft-deep);
    }
    .recipe:hover .recipe-cta :global(svg) {
      transform: translateX(3px);
    }
  }
</style>
