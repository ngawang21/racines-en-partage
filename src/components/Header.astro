---
// Site header (spec 5.5). Markup contract with wave 2B: the cart button is
// `button[data-cart-toggle][aria-controls="cart-drawer"]` holding
// `span[data-cart-count]`. The mobile menu is a <details>: a full-height
// panel (56 px rows, contact line and language at the bottom) over a scrim
// that closes it; it works without script, and header-menu.ts adds Escape,
// close on navigation, bfcache, the panel's top edge and the header that
// hides on scroll down on phones. The search button opens SearchDialog
// (mounted right after the header). Primary links: four (spec 8.5), recipes
// live in context and in the footer.
import { Image } from 'astro:assets';
import medallion from '../assets/brand/medallion.webp';
import { SITE, type Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Settings } from '../content/schemas';
import { formatPhone, formatPhoneIntl, phoneE164 } from '../i18n/format';
import { routePath, type RouteKey } from '../i18n/routing';
import Icon from './Icon.astro';
import LanguagePill from './LanguagePill.astro';
import SearchDialog from './SearchDialog.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
  t: LocaleContent;
  settings: Settings;
  /** Checkout tunnel: brand, language and a link back to the cart only. */
  minimal?: boolean;
}
const { locale, routeKey, slug, t, settings, minimal = false } = Astro.props;
const { phone, email } = settings.brand;
const phoneLabel = locale === 'fr' ? formatPhone(phone) : formatPhoneIntl(phone);
const home = routePath('home', locale);
// "Racines" / "en Partage": the wordmark stacks on two lines on narrow phones.
const [firstWord, ...others] = SITE.name.split(' ');
const rest = others.join(' ');
const active = (keys: RouteKey[]): 'page' | undefined =>
  keys.includes(routeKey) ? 'page' : undefined;
const links = [
  { href: routePath('shop', locale), label: t.nav.shop, current: active(['shop', 'category']) },
  { href: routePath('about', locale), label: t.nav.about, current: active(['about']) },
  { href: routePath('faq', locale), label: t.nav.faq, current: active(['faq']) },
  { href: routePath('contact', locale), label: t.nav.contact, current: active(['contact']) },
];
---

<header class:list={['site-header', { 'is-minimal': minimal }]} data-site-header>
  <div class="container-wide bar">
    {
      !minimal && (
        <details class="mobile-menu">
          <summary class="icon-btn">
            <Icon name="menu" class="when-closed" />
            <Icon name="close" class="when-open" />
            <span class="visually-hidden">{t.a11y.openMenu}</span>
          </summary>
          <nav class="mobile-nav" aria-label={t.nav.menu}>
            <ul role="list">
              {links.map((l) => (
                <li>
                  <a href={l.href} aria-current={l.current}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mobile-foot">
              <ul class="mobile-contact" role="list">
                {phone && (
                  <li>
                    <a href={`tel:${phoneE164(phone)}`}>
                      <Icon name="phone" size={20} />
                      <span>{phoneLabel}</span>
                    </a>
                  </li>
                )}
                {email && (
                  <li>
                    <a href={`mailto:${email}`}>
                      <Icon name="mail" size={20} />
                      <span>{email}</span>
                    </a>
                  </li>
                )}
              </ul>
              <LanguagePill
                {locale}
                {routeKey}
                {slug}
                label={t.a11y.language}
                class="mobile-pill"
              />
            </div>
          </nav>
        </details>
      )
    }

    <a class="brand" href={home} aria-current={routeKey === 'home' ? 'page' : undefined}>
      <Image src={medallion} alt="" width={40} height={40} densities={[1, 2]} loading="eager" />
      <span class="wordmark">
        {firstWord}
        {
          rest && (
            <>
              {' '}
              <span class="wordmark-rest">{rest}</span>
            </>
          )
        }
      </span>
    </a>

    {
      minimal ? (
        <div class="tools tools-minimal">
          <LanguagePill {locale} {routeKey} {slug} label={t.a11y.language} class="desktop-pill" />
        </div>
      ) : (
        <>
          <nav class="desktop-nav" aria-label={t.nav.primary}>
            <ul role="list">
              {links.map((l) => (
                <li>
                  <a href={l.href} aria-current={l.current}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="tools">
            <LanguagePill {locale} {routeKey} {slug} label={t.a11y.language} class="desktop-pill" />
            <button
              type="button"
              class="icon-btn search-toggle"
              data-search-open
              aria-controls="search-dialog"
              aria-haspopup="dialog"
            >
              <Icon name="search" />
              <span class="visually-hidden">{t.a11y.openSearch}</span>
            </button>
            <a
              class="icon-btn account-link"
              href={routePath('account', locale)}
              aria-current={routeKey === 'account' ? 'page' : undefined}
            >
              <Icon name="user" />
              <span class="visually-hidden">{t.a11y.account}</span>
            </a>
            <button
              type="button"
              class="icon-btn cart-toggle"
              data-cart-toggle
              aria-controls="cart-drawer"
            >
              <Icon name="cart" />
              <span class="visually-hidden">{t.a11y.openCart}</span>
              <span class="cart-count" data-cart-count>
                0
              </span>
              <span class="visually-hidden">{t.a11y.cartCount}</span>
            </button>
          </div>
        </>
      )
    }
  </div>
</header>
{!minimal && <SearchDialog {locale} {t} />}

<script>
  import './header-menu';
</script>

<style>
  .tools-minimal {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(251, 246, 234, 0.94);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--line);
    /* Held still while the rest of the page crossfades (global.css). */
    view-transition-name: site-header;
  }
  /* Phones: header-menu.ts slides the header away on scroll down and back on
     scroll up (transform only, no layout shift). Never under reduced motion. */
  @media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: transform 200ms var(--ease-out-strong);
    }
    .site-header.is-tucked {
      transform: translateY(-100%);
    }
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--header-h);
  }
  @media (min-width: 400px) {
    .bar {
      gap: var(--space-3);
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    min-height: 44px;
    margin-right: auto;
    border-radius: var(--radius-s);
    color: var(--forest);
    text-decoration: none;
  }
  .brand img {
    flex: none;
    width: 40px;
    height: 40px;
    transition: transform var(--dur-base) var(--ease-out-strong);
  }
  @media (hover: hover) {
    .brand:hover img {
      transform: rotate(-8deg);
    }
  }
  /* One line from 480 px (19 px). Narrower phones, where the search, account
     and cart buttons leave too little room, stack it: "Racines" over "en
     Partage"; below 360 px only the medallion shows (the name stays for
     assistive technology). */
  .wordmark {
    overflow: hidden;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: 'SOFT' 50;
    font-size: clamp(1.0625rem, 0.75rem + 1.6vw, 1.1875rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 479px) {
    .wordmark {
      font-size: 1rem;
      line-height: 1.05;
      white-space: normal;
    }
    .wordmark-rest {
      display: block;
    }
    .brand {
      gap: 6px;
    }
    .brand img {
      width: 36px;
      height: 36px;
    }
  }
  @media (max-width: 374px) {
    .wordmark {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .desktop-nav ul {
    display: flex;
    gap: clamp(var(--space-4), 0.5rem + 1.2vw, var(--space-6));
    margin: 0;
  }
  .desktop-nav a,
  .mobile-nav > ul a {
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }
  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }
  .desktop-nav a[aria-current] {
    color: var(--forest);
    border-bottom-color: var(--gold);
  }
  @media (hover: hover) {
    .desktop-nav a:hover {
      color: var(--forest);
      border-bottom-color: rgba(201, 162, 74, 0.55);
    }
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--forest);
    list-style: none;
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out-strong);
  }
  @media (hover: hover) {
    .icon-btn:hover {
      background: rgba(22, 58, 28, 0.06);
    }
  }
  .icon-btn:active {
    transform: scale(0.94);
  }
  .icon-btn::-webkit-details-marker {
    display: none;
  }
  .cart-count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: var(--radius-pill);
    background: var(--forest);
    color: var(--cream);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .mobile-menu {
    order: -1;
  }
  .mobile-menu summary {
    position: static;
    cursor: pointer;
  }
  .mobile-menu[open] summary {
    background: rgba(22, 58, 28, 0.06);
  }
  /* A transform would make the summary the containing block of its fixed
     scrim, which would then shrink under the finger between press and
     release: no press scale while the menu is open. */
  .mobile-menu[open] > summary:active {
    transform: none;
  }
  /* While the menu is open the header drops its backdrop filter (which would
     make it the containing block of fixed children), so the panel and the
     scrim are fixed to the viewport, from the header's bottom edge
     (--menu-top, set by header-menu.ts) to the bottom of the screen. */
  .site-header:has(.mobile-menu[open]) {
    background: var(--cream);
    backdrop-filter: none;
  }
  /* Scrim beside the panel. It belongs to the summary, so a tap on it closes
     the menu natively. */
  .mobile-menu[open] > summary::before {
    content: '';
    position: fixed;
    inset: var(--menu-top, var(--header-h)) 0 0;
    background: rgba(22, 58, 28, 0.6);
    cursor: default;
  }
  @media (max-width: 1023px) {
    /* Nothing scrolls behind the open menu. */
    :global(html:has(.mobile-menu[open])) {
      overflow: hidden;
    }
  }
  .mobile-menu :global(.when-open),
  .mobile-menu[open] :global(.when-closed) {
    display: none;
  }
  .mobile-menu[open] :global(.when-open) {
    display: block;
  }
  .mobile-nav {
    position: fixed;
    top: var(--menu-top, var(--header-h));
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    width: min(88vw, 400px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-2) var(--gutter) calc(var(--space-6) + env(safe-area-inset-bottom));
    background: var(--cream);
    border-right: 1px solid var(--line);
    box-shadow: var(--shadow-float);
  }
  /* Phones: the panel takes the whole width, so no cropped page shows
     beside it; tablets keep a side sheet over a dim scrim. */
  @media (max-width: 599px) {
    .mobile-nav {
      width: 100%;
      border-right: 0;
      box-shadow: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] .mobile-nav {
      animation: rep-menu-in 240ms var(--ease-out-strong);
    }
    .mobile-menu[open] > summary::before {
      animation: rep-scrim-in 240ms ease;
    }
  }
  @keyframes rep-menu-in {
    from {
      transform: translateX(-24px);
      opacity: 0;
    }
  }
  @keyframes rep-scrim-in {
    from {
      opacity: 0;
    }
  }
  .mobile-nav > ul {
    margin: 0;
  }
  .mobile-nav > ul a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    font-family: var(--font-display);
    font-size: var(--fs-2);
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-fast) ease;
  }
  .mobile-nav > ul a::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-top: 1.5px solid var(--kraft-deep);
    border-right: 1.5px solid var(--kraft-deep);
    transform: rotate(45deg);
  }
  .mobile-nav > ul a:active {
    color: var(--forest);
  }
  .mobile-nav > ul a[aria-current] {
    color: var(--forest);
    font-weight: 600;
  }
  .mobile-nav > ul a[aria-current]::before {
    content: '';
    position: absolute;
    left: calc(var(--gutter) * -1);
    width: 3px;
    height: 24px;
    border-radius: 0 2px 2px 0;
    background: var(--gold);
  }
  /* Contact line and language at the bottom of the panel, by the thumb. */
  .mobile-foot {
    display: grid;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-8);
  }
  .mobile-contact {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }
  .mobile-contact a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--forest);
    font-size: 0.9375rem;
    font-variant-numeric: lining-nums;
    text-decoration: none;
  }
  .mobile-contact :global(svg) {
    flex: none;
    color: var(--leaf);
  }
  .mobile-foot :global(.mobile-pill) {
    justify-self: start;
  }
  .desktop-nav,
  .tools :global(.desktop-pill) {
    display: none;
  }
  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
    .desktop-nav {
      display: block;
      margin-right: var(--space-6);
    }
    .tools :global(.desktop-pill) {
      display: inline-flex;
    }
  }
</style>
