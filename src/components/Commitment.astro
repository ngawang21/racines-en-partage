---
// "Nos engagements", the last band of the home page, on paper: who the ESAT
// is and what its team does (title, body and the story link on the left; the
// trust strip already says where the pouches are packed) and three label
// commitments as a short list with icons on the right (origin, short lists,
// a serving idea: the strip already promises "no additive"), so the band
// holds both edges from 900 px. One column on phones.
import type { LocaleContent } from '../content/locale-schema';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  body: string;
  link: { href: string; label: string };
  t: LocaleContent;
}
const { title, body, link, t } = Astro.props;
const c = t.shop.commitments;
const items: Array<{ icon: IconName; text: string }> = [
  { icon: 'pin', text: c.origin },
  { icon: 'leaf', text: c.ingredients },
  { icon: 'check', text: c.usage },
];
---

<section class="band-paper commitment" aria-labelledby="commitment-title">
  <div class="container section inner">
    <div class="copy">
      <h2 id="commitment-title">{title}</h2>
      <p class="body">{body}</p>
      <a class="link-arrow" href={link.href}>{link.label}</a>
    </div>
    <ul class="pledges" role="list">
      {
        items.map((item) => (
          <li>
            <span class="pledge-icon">
              <Icon name={item.icon} size={22} />
            </span>
            <span class="pledge-text">{item.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .commitment {
    border-top: 1px solid var(--kraft);
  }
  .inner {
    display: grid;
    gap: var(--space-8);
  }
  /* Two columns from 900 px: the copy keeps its measure on the left, the
     list runs to the right edge, centred on each other vertically. */
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: clamp(var(--space-12), 6vw, 96px);
    }
  }
  .copy {
    max-width: 62ch;
  }
  h2 {
    font-size: var(--fs-4);
    text-wrap: balance;
  }
  .body {
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--fs-1);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .link-arrow {
    margin-top: var(--space-4);
  }
  .pledges {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--kraft);
  }
  .pledges li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 76px;
    padding-block: var(--space-3);
    border-top: 1px solid var(--kraft);
  }
  .pledge-icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--kraft);
    border-radius: 50%;
    background: var(--cream);
    color: var(--leaf);
  }
  /* One line each from about 950 px; the display size from 1280 px. */
  .pledge-text {
    color: var(--forest);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    line-height: 1.3;
    text-wrap: balance;
  }
  @media (min-width: 1280px) {
    .pledge-text {
      font-size: var(--fs-2);
    }
  }
</style>
