---
// Commitment band on paper: the ESAT partnership, origins and plain
// ingredients (spec 5.4), type only, centred.
interface Props {
  title: string;
  body: string;
  link: { href: string; label: string };
}
const { title, body, link } = Astro.props;
---

<section class="band-paper commitment" aria-labelledby="commitment-title">
  <div class="container section inner">
    <div class="copy">
      <h2 id="commitment-title">{title}</h2>
      <p class="body">{body}</p>
      <a class="link-arrow" href={link.href}>{link.label}</a>
    </div>
  </div>
</section>

<style>
  .commitment {
    border-top: 1px solid var(--kraft);
  }
  .copy {
    max-width: 62ch;
  }
  h2 {
    font-size: var(--fs-4);
  }
  .body {
    margin-top: var(--space-4);
    max-width: 62ch;
    color: var(--ink-2);
    font-size: var(--fs-1);
    line-height: 1.65;
  }
  .link-arrow {
    margin-top: var(--space-4);
  }
</style>
