---
// "Ils en parlent" on the home page (spec 2.1): the three most recent
// published reviews, each with its product, once at least three are
// published site-wide. Renders nothing below that.
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Product, Review } from '../content/schemas';
import { interpolate } from '../i18n/fallback';
import { formatDate } from '../i18n/format';
import { routePath } from '../i18n/routing';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import Stars from './Stars.astro';
import { ratingLabel } from './reviews';

const REVIEWS_BAND_MIN = 3;

interface Props {
  /** Published reviews, newest first (loadReviews). */
  reviews: Review[];
  /** The products of the page locale, to name and link each review's product. */
  products: Product[];
  locale: Locale;
  t: LocaleContent;
}
const { reviews, products, locale, t } = Astro.props;
const bySlug = new Map(products.map((p) => [p.slug, p]));
const shown = reviews
  .filter((r) => bySlug.has(r.product))
  .slice(0, 3)
  .map((r) => ({ review: r, product: bySlug.get(r.product)! }));
---

{
  reviews.length >= REVIEWS_BAND_MIN && shown.length > 0 && (
    <section class="band-paper reviews-band" aria-labelledby="reviews-band-title">
      <div class="container section">
        <SectionHead
          id="reviews-band-title"
          title={t.reviews.bandTitle}
          eyebrow={t.reviews.bandKicker}
        />
        <ul class="quotes" role="list">
          {shown.map(({ review: r, product: p }) => {
            const foreign = r.locale !== locale;
            return (
              <li>
                <figure class="quote">
                  <Stars rating={r.rating} label={ratingLabel(r.rating, t, locale)} size={16} />
                  <blockquote lang={foreign ? r.locale : undefined}>
                    {r.title && <p class="quote-title">{r.title}</p>}
                    <p class="quote-text">{r.text}</p>
                  </blockquote>
                  <figcaption>
                    <span class="quote-by">
                      {interpolate(t.reviews.by, {
                        author: r.author,
                        date: formatDate(r.date, locale),
                      })}
                    </span>
                    {r.verified && (
                      <span class="quote-verified">
                        <Icon name="shield" size={14} />
                        {t.reviews.verified}
                      </span>
                    )}
                    <a
                      class="quote-product"
                      href={`${routePath('product', locale, p.slug)}#reviews`}
                    >
                      {p.name}
                      <Icon name="chevron" size={16} />
                    </a>
                  </figcaption>
                </figure>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .reviews-band {
    border-block: 1px solid var(--kraft);
  }
  .quotes {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }
  @media (min-width: 760px) {
    .quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    margin: 0;
    padding: clamp(var(--space-4), 1rem + 1vw, var(--space-6));
    border: 1px solid var(--kraft);
    border-radius: var(--radius-m);
    background: var(--cream);
  }
  blockquote {
    margin: 0;
  }
  .quote-title {
    margin-bottom: var(--space-2);
    color: var(--forest);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 600;
    line-height: 1.3;
  }
  /* Long reviews are cut at six lines; the product page shows them in full. */
  .quote-text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    line-height: 1.6;
  }
  figcaption {
    display: grid;
    gap: 4px;
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--fs--1);
  }
  .quote-verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--leaf-ink);
    font-weight: 600;
  }
  .quote-product {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    color: var(--forest);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--kraft);
    text-underline-offset: 4px;
  }
  .quote-product :global(svg) {
    flex: none;
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) {
    .quote-product:hover {
      text-decoration-color: var(--forest);
    }
    .quote-product:hover :global(svg) {
      transform: translateX(3px);
    }
  }
</style>
