---
// "Un rituel, trois moments": the brand's word made concrete. Three times of
// the day, one sentence each, a link to the recipe and the name of its
// product. A type moment on cream between the reviews and the engagements;
// above the time, the close-up of the product's contents when it exists (a
// 2:1 strip, decorative: the link names the recipe), nothing otherwise.
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  title: string;
  moments: Array<{
    time: string;
    text: string;
    /** The recipe title, the link text. */
    title: string;
    href: string;
    productName?: string;
    /** `/src/assets/products/detail/<file>`, when the strip exists. */
    detail?: string;
  }>;
  link: { href: string; label: string };
}
const { title, moments, link } = Astro.props;
---

<section class="ritual" aria-labelledby="ritual-title">
  <div class="container section">
    <div class="ritual-head">
      <h2 id="ritual-title">{title}</h2>
      <a class="link-arrow" href={link.href}>
        {link.label}
        <Icon name="chevron" />
      </a>
    </div>
    <ol class="moments" role="list">
      {
        moments.map((m) => (
          <li class="moment">
            {m.detail && (
              <div class="moment-media">
                <Picture
                  src={m.detail}
                  alt=""
                  preset="card"
                  sizes="(min-width: 1440px) 400px, (min-width: 720px) 30vw, 100vw"
                />
              </div>
            )}
            <p class="moment-time">{m.time}</p>
            <p class="moment-text">{m.text}</p>
            <a class="moment-link" href={m.href}>
              {m.title}
            </a>
            {m.productName && <p class="moment-product">{m.productName}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ritual {
    border-bottom: 1px solid var(--kraft);
  }
  .ritual-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-bottom: clamp(var(--space-8), 4vw, var(--space-12));
  }
  h2 {
    font-size: var(--fs-5);
  }
  .moments {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
  }
  /* Three equal columns; the kraft rule sits in the middle of each gap, so
     every moment (and its close-up) has the same width. */
  @media (min-width: 720px) {
    .moments {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-16);
    }
    .moment {
      position: relative;
    }
    .moment + .moment::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--space-16) / -2);
      border-left: 1px solid var(--kraft);
    }
  }
  @media (min-width: 720px) and (max-width: 1079px) {
    .moments {
      gap: var(--space-8);
    }
    .moment + .moment::before {
      left: calc(var(--space-8) / -2);
    }
  }
  .moment-media {
    margin-bottom: var(--space-6);
    overflow: hidden;
    aspect-ratio: 2 / 1;
    border-radius: var(--radius-m);
    background: var(--photo-ground);
  }
  .moment-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .moment-time {
    color: var(--hibiscus-deep);
    font-family: var(--font-display);
    font-size: var(--fs-4);
    font-style: italic;
    line-height: 1.1;
  }
  .moment-text {
    margin-top: var(--space-3);
    max-width: 30ch;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--fs-2);
    line-height: 1.3;
    text-wrap: balance;
  }
  .moment-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--forest);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--kraft);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 200ms ease;
  }
  .moment-product {
    margin-top: var(--space-1);
    color: var(--ink-2);
    font-size: var(--fs--1);
  }
  @media (hover: hover) {
    .moment-link:hover {
      text-decoration-color: var(--forest);
    }
  }
</style>
