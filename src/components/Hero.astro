---
// Home hero (spec 5.4, premium standard sections 2 and 3). The slogan is a
// small italic kicker; the H1 names what is sold, in one colour; one primary
// button, then "Notre histoire" as a plain text link.
// From 960 px: copy and photo share the content container (same inset on
// both sides, the copy's left edge on the header wordmark), the photo framed
// with rounded corners on all four sides. The H1 is sized on its own column
// (container query units) so it keeps to three lines at 1440 px and wider.
// Under 960 px: the photo comes first (4:3, inside the gutter), then the copy.
// The photo is the LCP element: eager, fetchpriority high. The 3:2 photo is
// cropped to 4:3, so the rendered image is 1.125 times the frame width:
// `sizes` accounts for it.
// Entrance: the copy rises in a short stagger, the photo settles from a
// slight zoom (transform only, so the LCP image is never transparent). All of
// it is off under prefers-reduced-motion.
import heroTrio from '../assets/brand/hero-trio.webp';
import type { HomePage } from '../content/schemas';
import Picture from './Picture.astro';

interface Props {
  hero: HomePage['hero'];
  primaryHref: string;
  secondaryHref: string;
}
const { hero, primaryHref, secondaryHref } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="lead hero-lead">{hero.lead}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={primaryHref}>{hero.cta.primary}</a>
        <a class="link-arrow hero-link" href={secondaryHref}>{hero.cta.secondary}</a>
      </div>
    </div>
    <div class="hero-media">
      <div class="hero-frame">
        <Picture
          src={heroTrio}
          alt={hero.imageAlt}
          preset="hero"
          sizes="(min-width: 1552px) 690px, (min-width: 960px) 45vw, calc(112.5vw - 45px)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-4), 0.25rem + 3vw, var(--space-16))
      clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    align-items: center;
  }
  /* Phones and tablets: the photo first. */
  .hero-media {
    order: -1;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    }
    .hero-media {
      order: 0;
    }
    .hero-copy {
      container-type: inline-size;
    }
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-2);
  }
  /* The rule sits on the first line when the slogan wraps (phones). */
  .hero-kicker::before {
    content: '';
    flex: none;
    align-self: flex-start;
    margin-top: 0.65em;
    width: 28px;
    height: 1px;
    background: var(--gold);
  }
  h1 {
    margin-top: var(--space-4);
    max-width: 22ch;
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  @media (min-width: 960px) {
    /* Sized on the copy column: about 12.8 em of measure, three lines. */
    h1 {
      max-width: none;
      font-size: clamp(2.5rem, 7.8cqi, 4rem);
    }
  }
  .hero-lead {
    margin-top: var(--space-6);
    max-width: 46ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
    margin-top: var(--space-8);
  }
  @media (max-width: 479px) {
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }
  .hero-frame {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--kraft);
    border-radius: var(--radius-m);
    background: var(--paper);
  }
  @media (min-width: 960px) {
    .hero-frame {
      max-height: min(76vh, 640px);
      border-radius: var(--radius-l);
      box-shadow: var(--shadow-soft);
    }
  }
  .hero-frame :global(picture),
  .hero-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-frame :global(img) {
    object-fit: cover;
    object-position: 50% 55%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-kicker,
    h1,
    .hero-lead,
    .hero-ctas {
      animation: rep-hero-rise 480ms var(--ease-out-strong) both;
    }
    h1 {
      animation-delay: 60ms;
    }
    .hero-lead {
      animation-delay: 140ms;
    }
    .hero-ctas {
      animation-delay: 200ms;
    }
    .hero-frame :global(img) {
      animation: rep-hero-settle 500ms var(--ease-out-strong) both;
    }
  }
  @keyframes rep-hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes rep-hero-settle {
    from {
      transform: scale(1.04);
    }
  }
</style>
