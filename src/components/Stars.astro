---
// Five stars, filled to `rating` (partial fill for halves and tenths). The
// row is one image for assistive technology: `label` is its text
// ("4,5 sur 5"). Inline SVG, no script; the fill is a clipped second row.
interface Props {
  /** 0 to 5. */
  rating: number;
  label: string;
  /** Star size in pixels. */
  size?: number;
  class?: string;
}
const { rating, label, size = 16, class: className } = Astro.props;
const fill = Math.max(0, Math.min(5, rating)) * 20;
// Five-point star in a 24 px cell, five cells in a row.
const STAR = 'M12 2.8l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.6l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z';
const row = [0, 1, 2, 3, 4]
  .map((i) => `<path transform="translate(${i * 24} 0)" d="${STAR}"/>`)
  .join('');
---

<span
  class:list={['stars', className]}
  role="img"
  aria-label={label}
  style={`--star: ${size}px; --fill: ${fill}%`}
>
  <svg
    class="stars-empty"
    viewBox="0 0 120 24"
    aria-hidden="true"
    focusable="false"
    set:html={row}
  />
  <span class="stars-fill">
    <svg viewBox="0 0 120 24" aria-hidden="true" focusable="false" set:html={row} />
  </span>
</span>

<style>
  .stars {
    position: relative;
    display: inline-block;
    flex: none;
    width: calc(var(--star) * 5);
    height: var(--star);
    line-height: 0;
    vertical-align: -0.15em;
  }
  /* Fixed size: the reset's max-width: 100% would squeeze the clipped row. */
  svg {
    display: block;
    width: calc(var(--star) * 5);
    max-width: none;
    height: var(--star);
  }
  .stars-empty {
    fill: none;
    stroke: var(--kraft-deep);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--fill);
    overflow: hidden;
  }
  .stars-fill svg {
    fill: var(--gold);
    stroke: var(--gold);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  @media (forced-colors: active) {
    .stars-empty {
      stroke: CanvasText;
    }
    .stars-fill svg {
      fill: CanvasText;
      stroke: CanvasText;
    }
  }
</style>
