---
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Product } from '../content/schemas';
import { reviewStats } from '../content/merge';
import { loadReviews, loadSettings, reviewsFor } from '../i18n/locale';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  locale: Locale;
  t: LocaleContent;
  shopOpen: boolean;
  headingLevel?: 'h2' | 'h3';
  id?: string;
  class?: string;
  /** Fade the cards up on scroll, staggered (home page, reveal.ts). */
  reveal?: boolean;
}
const {
  products,
  locale,
  t,
  shopOpen,
  headingLevel,
  id,
  class: className,
  reveal = false,
} = Astro.props;
const [reviews, settings] = await Promise.all([loadReviews(), loadSettings()]);
const showRatings = settings.reviews.enabled;
---

<ul class:list={['product-grid', className]} role="list" {id} data-product-grid>
  {
    products.map((product, index) => (
      <li data-product-item data-reveal={reveal ? '' : undefined}>
        <ProductCard
          {product}
          {locale}
          {t}
          {shopOpen}
          {index}
          {headingLevel}
          rating={showRatings ? reviewStats(reviewsFor(product.slug, reviews)) : undefined}
        />
      </li>
    ))
  }
</ul>
