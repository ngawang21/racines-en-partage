---
// A grid of product cards: one card per product family (moringa 100 g and
// 200 g make one card showing the 100 g, with a chip per format). Families
// are defined in French (formatsOf) and the chips list every format of the
// catalogue, even when `products` holds only one of them.
import { DEFAULT_LOCALE, type Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Product } from '../content/schemas';
import { formatFamilies, groupFormats, reviewStats } from '../content/merge';
import { loadProducts, loadReviews, loadSettings, reviewsFor } from '../i18n/locale';
import ProductCard from './ProductCard.astro';
import { gridColumnsStyle } from './storefront';

interface Props {
  products: Product[];
  locale: Locale;
  t: LocaleContent;
  shopOpen: boolean;
  headingLevel?: 'h2' | 'h3';
  id?: string;
  class?: string;
  /** Cards loaded eagerly (the first row of a page that opens on the grid). */
  eager?: number;
  /**
   * Pick the column count per viewport so the last row never holds one card
   * alone (shop and category pages; storefront.ts balancedColumns). The shop
   * filter recomputes it for the visible cards.
   */
  balance?: boolean;
}
const {
  products,
  locale,
  t,
  shopOpen,
  headingLevel,
  id,
  class: className,
  eager = 0,
  balance = false,
} = Astro.props;
const [reviews, settings, all, allFr] = await Promise.all([
  loadReviews(),
  loadSettings(),
  loadProducts(locale),
  loadProducts(DEFAULT_LOCALE),
]);
const showRatings = settings.reviews.enabled;
// Balanced grids show three columns up to 1599 px (square frames from
// 1080 px, the photo up to 1.13 times the card width), five from 1600 px.
const sizes = balance
  ? '(min-width: 1600px) 330px, (min-width: 1080px) 34vw, (min-width: 720px) 36vw, 54vw'
  : undefined;
const groups = groupFormats(products, all, formatFamilies(allFr));
---

<ul
  class:list={['product-grid', className]}
  role="list"
  {id}
  data-product-grid
  data-balance={balance ? '' : undefined}
  style={balance ? gridColumnsStyle(groups.length) : undefined}
>
  {
    groups.map(({ lead, formats }, index) => (
      <li data-product-item>
        <ProductCard
          product={lead}
          {formats}
          {locale}
          {t}
          {shopOpen}
          {index}
          {headingLevel}
          eager={index < eager}
          {sizes}
          rating={
            showRatings
              ? reviewStats(formats.flatMap((f) => reviewsFor(f.slug, reviews)))
              : undefined
          }
        />
      </li>
    ))
  }
</ul>

<style>
  /* Each item spans four rows of the grid (photo, name, meta, price) that
     its card shares through subgrid (ProductCard), so a row of cards aligns.
     A filtered-out item ([hidden]) stays hidden. */
  @supports (grid-template-rows: subgrid) {
    .product-grid > li:not([hidden]) {
      display: grid;
      grid-row: span 4;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }
</style>
