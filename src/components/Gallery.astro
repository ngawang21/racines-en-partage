---
// Product gallery (spec 5.4): one main picture per photo, only the active one
// shown, and a row of thumbnail buttons when there is more than one photo.
// gallery.ts switches the picture; arrow keys move between thumbnails.
// The first photo is the LCP element of the page: eager, high priority.
import type { ImageMetadata } from 'astro';
import { interpolate } from '../i18n/fallback';
import GalleryScript from './GalleryScript.astro';
import Picture from './Picture.astro';

interface Props {
  images: Array<{ src: string | ImageMetadata; alt: string }>;
  label: string;
  /** "Photo {n} sur {total}" */
  thumbLabel: string;
}
const { images, label, thumbLabel } = Astro.props;
const many = images.length > 1;
---

<div class:list={['gallery', { many }]} data-gallery role="group" aria-label={label}>
  <div class="frame gallery-main">
    {
      images.map((img, i) => (
        <div class="gallery-slide" data-gallery-slide={i} id={`gallery-slide-${i}`} hidden={i > 0}>
          <Picture
            src={img.src}
            alt={img.alt}
            preset="gallery"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
    <slot />
  </div>
  {
    many && (
      <div class="thumbs">
        {images.map((img, i) => (
          <button
            type="button"
            class="thumb"
            data-gallery-thumb={i}
            aria-controls={`gallery-slide-${i}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={interpolate(thumbLabel, { n: i + 1, total: images.length })}
          >
            <Picture src={img.src} alt="" preset="thumb" />
          </button>
        ))}
      </div>
    )
  }
</div>

{many && <GalleryScript />}

<style>
  .gallery-main {
    position: relative;
  }
  @media (min-width: 900px) {
    .gallery.many {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      gap: var(--space-4);
      align-items: start;
    }
    .gallery.many .thumbs {
      grid-row: 1;
      grid-column: 1;
      flex-direction: column;
      margin-top: 0;
    }
  }
  .gallery-slide {
    height: 100%;
  }
  .gallery-slide[hidden] {
    display: none;
  }
  .gallery-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .thumbs {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .thumb {
    width: 76px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--kraft);
    border-radius: var(--radius-s);
    background: var(--paper);
    opacity: 0.72;
    touch-action: manipulation;
    transition:
      opacity var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out-strong);
  }
  .thumb:active {
    transform: scale(0.96);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb:hover {
    opacity: 1;
  }
  .thumb[aria-pressed='true'] {
    border: 2px solid var(--forest);
    opacity: 1;
  }
</style>
