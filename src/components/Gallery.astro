---
// Product gallery (spec 5.4): one main picture per photo, only the active one
// shown, and a thumbnail button per photo when there is more than one: a
// column beside the photo from 900 px, dots on the photo on phones (where
// the photo is square, so the name, price and add button fit the first
// screen). gallery.ts switches the picture; arrow keys move between them.
// The first photo is the LCP element of the page: eager, high priority.
//
// Larger view (iteration 4, spec 3): a button over the main photo opens a
// modal <dialog> with the photo fitted to the viewport. Its pictures sit in
// <template>s, so nothing is fetched before the dialog opens; gallery.ts
// clones the one it shows. On phones the photo takes the whole width and the
// page's native pinch zoom still works.
//
// Zoom (review 17): the fitted photo is often no larger than the one on the
// page, so a click on it (Enter or Space once focused, double tap on touch,
// or the "+" and "−" buttons) toggles a 2x view that pans with a drag, the
// wheel or the arrow keys. The files stay capped at 1200 px wide on purpose
// (the `zoom` preset of Picture.astro, src/assets/brand/README.md): the 2x
// view is a CSS scale of the largest of them, never more than 2x.
import type { ImageMetadata } from 'astro';
import { interpolate } from '../i18n/fallback';
import { resolveAsset } from '../images';
import { loadLocale } from '../i18n/locale';
import { getLocaleFromUrl } from '../i18n/routing';
import GalleryScript from './GalleryScript.astro';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props {
  images: Array<{ src: string | ImageMetadata; alt: string }>;
  label: string;
  /** "Photo {n} sur {total}" */
  thumbLabel: string;
  /** Accessible name of the button that opens the larger view. */
  enlargeLabel?: string;
  /** Accessible name of the larger view's close button. */
  closeLabel?: string;
  /** Accessible names of the larger view's previous and next buttons. */
  previousLabel?: string;
  nextLabel?: string;
  /** Accessible names of the larger view's zoom buttons (default: the product strings). */
  zoomInLabel?: string;
  zoomOutLabel?: string;
}

// Defaults until the strings move to the locale files (product namespace).
const DEFAULTS = {
  fr: {
    enlarge: 'Agrandir la photo',
    close: 'Fermer',
    previous: 'Photo précédente',
    next: 'Photo suivante',
  },
  en: {
    enlarge: 'Enlarge the photo',
    close: 'Close',
    previous: 'Previous photo',
    next: 'Next photo',
  },
} as const;
const locale = getLocaleFromUrl(Astro.url);
const fallback = DEFAULTS[locale] ?? DEFAULTS.fr;
const { product: strings } = await loadLocale(locale);

const {
  images,
  label,
  thumbLabel,
  enlargeLabel = fallback.enlarge,
  closeLabel = fallback.close,
  previousLabel = fallback.previous,
  nextLabel = fallback.next,
  zoomInLabel = strings.zoomIn,
  zoomOutLabel = strings.zoomOut,
} = Astro.props;
const many = images.length > 1;

// The large view fits the photo to the viewport: as wide as the screen on a
// tall screen, as tall as the screen (so narrower) on a wide one.
const zoomSizes = images.map((img) => {
  const meta = typeof img.src === 'string' ? resolveAsset(img.src) : img.src;
  const w = meta.width;
  const h = meta.height;
  return `(min-aspect-ratio: ${w}/${h}) calc(100vh * ${w} / ${h}), 100vw`;
});
---

<div class:list={['gallery', { many }]} data-gallery role="group" aria-label={label}>
  <div class="frame gallery-main">
    {
      images.map((img, i) => (
        <div class="gallery-slide" data-gallery-slide={i} id={`gallery-slide-${i}`} hidden={i > 0}>
          <Picture
            src={img.src}
            alt={img.alt}
            preset="gallery"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
    <slot />
    <button
      type="button"
      class="gallery-zoom"
      data-gallery-open
      aria-haspopup="dialog"
      aria-controls="gallery-dialog"
      aria-label={enlargeLabel}
    >
      <span class="zoom-badge" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
        </svg>
      </span>
    </button>
  </div>
  {
    many && (
      <div class="thumbs">
        {images.map((img, i) => (
          <button
            type="button"
            class="thumb"
            data-gallery-thumb={i}
            aria-controls={`gallery-slide-${i}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={interpolate(thumbLabel, { n: i + 1, total: images.length })}
          >
            <Picture src={img.src} alt="" preset="thumb" loading="eager" />
          </button>
        ))}
      </div>
    )
  }

  <dialog id="gallery-dialog" class="lightbox" aria-label={label} data-gallery-dialog>
    <div class="lightbox-stage" data-gallery-stage></div>
    {
      images.map((img, i) => (
        <template data-gallery-large={i}>
          <Picture src={img.src} alt={img.alt} preset="zoom" sizes={zoomSizes[i]} loading="eager" />
        </template>
      ))
    }
    <button
      type="button"
      class="lightbox-btn lightbox-zoom-out"
      data-gallery-zoom="out"
      aria-disabled="true"
    >
      <Icon name="minus" />
      <span class="visually-hidden">{zoomOutLabel}</span>
    </button>
    <button
      type="button"
      class="lightbox-btn lightbox-zoom-in"
      data-gallery-zoom="in"
      aria-disabled="false"
    >
      <Icon name="plus" />
      <span class="visually-hidden">{zoomInLabel}</span>
    </button>
    <button type="button" class="lightbox-btn lightbox-close" data-gallery-close>
      <Icon name="close" />
      <span class="visually-hidden">{closeLabel}</span>
    </button>
    {
      many && (
        <>
          <button type="button" class="lightbox-btn lightbox-prev" data-gallery-step="-1">
            <Icon name="chevron" />
            <span class="visually-hidden">{previousLabel}</span>
          </button>
          <button type="button" class="lightbox-btn lightbox-next" data-gallery-step="1">
            <Icon name="chevron" />
            <span class="visually-hidden">{nextLabel}</span>
          </button>
          <p class="lightbox-count" data-gallery-count aria-live="polite" />
        </>
      )
    }
  </dialog>
</div>

<GalleryScript />

<style>
  .gallery {
    position: relative;
  }
  .gallery-main {
    position: relative;
  }
  /* From 900 px the gallery is sticky: the photo never grows taller than the
     screen under the header, so it is always seen whole. */
  @media (min-width: 900px) {
    .gallery-main {
      width: min(100%, calc((100vh - var(--header-h) - 3rem) * 0.8));
    }
    .gallery.many {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      gap: var(--space-4);
      align-items: start;
    }
    .gallery.many .thumbs {
      grid-row: 1;
      grid-column: 1;
      flex-direction: column;
      margin-top: 0;
    }
  }
  .gallery-slide {
    height: 100%;
  }
  .gallery-slide[hidden] {
    display: none;
  }
  .gallery-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  /* The whole photo is the enlarge button; the corner badge says so. */
  .gallery-zoom {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: var(--space-3);
    border: 0;
    background: transparent;
    cursor: zoom-in;
    touch-action: manipulation;
  }
  .gallery-zoom:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: -4px;
  }
  .zoom-badge {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(251, 246, 234, 0.88);
    color: var(--forest);
    transition: transform var(--dur-press) var(--ease-out-strong);
  }
  .gallery-zoom:active .zoom-badge {
    transform: scale(0.94);
  }
  @media (hover: hover) {
    .gallery-zoom:hover .zoom-badge {
      background: var(--cream);
    }
  }

  .thumbs {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .thumb {
    width: 76px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--kraft);
    border-radius: var(--radius-s);
    background: var(--paper);
    opacity: 0.72;
    touch-action: manipulation;
    transition:
      opacity var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out-strong);
  }
  .thumb:active {
    transform: scale(0.96);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: hover) {
    .thumb:hover {
      opacity: 1;
    }
  }
  .thumb[aria-pressed='true'] {
    border: 2px solid var(--forest);
    opacity: 1;
  }
  /* Phones: a square photo (the pouch sits in its middle) and the thumbnails
     as dots on a cream pill at the bottom of the photo, 28 px targets. */
  @media (max-width: 899px) {
    .gallery-main {
      aspect-ratio: 1 / 1;
    }
    .gallery-slide :global(img) {
      object-position: 50% 52%;
    }
    .thumbs {
      position: absolute;
      z-index: 2;
      bottom: var(--space-3);
      left: 50%;
      gap: 2px;
      margin: 0;
      padding: 0 6px;
      border-radius: var(--radius-pill);
      background: rgba(251, 246, 234, 0.88);
      transform: translateX(-50%);
    }
    .thumb,
    .thumb[aria-pressed='true'] {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      aspect-ratio: auto;
      border: 0;
      border-radius: 50%;
      background: transparent;
      opacity: 1;
    }
    .thumb :global(picture) {
      display: none;
    }
    .thumb::before {
      content: '';
      width: 8px;
      height: 8px;
      border: 1.5px solid var(--forest);
      border-radius: 50%;
      transition: background-color var(--dur-fast) ease;
    }
    .thumb[aria-pressed='true']::before {
      background: var(--forest);
    }
  }

  /* Larger view: the whole viewport, the photo centred and fitted. The page
     under it does not scroll; the reserved gutter keeps it from shifting and
     takes the overlay's colour (a fixed element does not cover it). */
  :global(html:has(.lightbox[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
    background: rgb(16, 22, 14);
  }
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(16, 22, 14, 0.97);
    color: var(--cream);
    overscroll-behavior: contain;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lightbox-in var(--dur-fast) ease-out;
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
  /* Clips the 2x view: the dialog never scrolls, so nothing moves around it. */
  .lightbox-stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }
  /* gallery.ts adds one frame per photo shown, stacked in the same cell. */
  .lightbox-stage :global(.lightbox-frame) {
    display: grid;
    grid-area: 1 / 1;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .lightbox-stage :global(.lightbox-frame[hidden]) {
    display: none;
  }
  .lightbox-stage :global(picture) {
    display: contents;
  }
  /* Otherwise each <source> would take a grid row and push the photo down. */
  .lightbox-stage :global(source) {
    display: none;
  }
  /* Fitted with viewport units (a percentage of the stacked frames does not
     resolve); never larger than the file, whose size the width and height
     attributes give. */
  .lightbox-stage :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100vw;
    max-height: 100vh;
    max-height: 100dvh;
    object-fit: contain;
    cursor: zoom-in;
    /* Native pinch stays; no double-tap page zoom, so a double tap toggles ours. */
    touch-action: manipulation;
    transform-origin: 50% 50%;
    transition: transform var(--dur-base) var(--ease-out-strong);
    user-select: none;
    -webkit-user-drag: none;
  }
  /* The 2x view (gallery.ts sets the transform): a drag pans, a click returns
     to the whole photo. One finger pans, two still pinch. No will-change: the
     browser then re-rasterises the scaled photo sharp once it settles. */
  .lightbox.is-zoomed .lightbox-stage :global(img) {
    cursor: zoom-out;
    touch-action: pinch-zoom;
  }
  .lightbox.is-dragging .lightbox-stage :global(img) {
    cursor: grabbing;
    transition: none;
  }
  .lightbox-stage :global(img:focus-visible) {
    outline: 2px solid var(--cream);
    outline-offset: -4px;
    box-shadow: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-stage :global(img) {
      transition: none;
    }
  }
  /* Wide screens: a margin of dark around the photo, clear of the arrows. */
  @media (min-width: 900px) {
    .lightbox-stage :global(img) {
      max-width: calc(100vw - 2 * var(--space-16));
      max-height: calc(100vh - 2 * var(--space-12));
      max-height: calc(100dvh - 2 * var(--space-12));
    }
  }
  .lightbox-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(251, 246, 234, 0.9);
    color: var(--forest);
    cursor: pointer;
    touch-action: manipulation;
    transition: transform var(--dur-press) var(--ease-out-strong);
  }
  .lightbox-btn:active {
    transform: scale(0.94);
  }
  .lightbox-btn:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 3px;
  }
  .lightbox-close {
    top: max(var(--space-3), env(safe-area-inset-top));
    right: max(var(--space-3), env(safe-area-inset-right));
  }
  /* "−" and "+" in the top left corner, clear of the close button. */
  .lightbox-zoom-out,
  .lightbox-zoom-in {
    top: max(var(--space-3), env(safe-area-inset-top));
  }
  .lightbox-zoom-out {
    left: max(var(--space-3), env(safe-area-inset-left));
  }
  .lightbox-zoom-in {
    left: calc(max(var(--space-3), env(safe-area-inset-left)) + 44px + var(--space-2));
  }
  .lightbox-btn[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
  }
  .lightbox-btn[aria-disabled='true']:active {
    transform: none;
  }
  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    margin-top: -22px;
  }
  .lightbox-prev {
    left: max(var(--space-3), env(safe-area-inset-left));
  }
  .lightbox-prev :global(svg) {
    transform: scaleX(-1);
  }
  .lightbox-next {
    right: max(var(--space-3), env(safe-area-inset-right));
  }
  .lightbox-count {
    position: absolute;
    bottom: max(var(--space-3), env(safe-area-inset-bottom));
    left: 50%;
    margin: 0;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: rgba(18, 26, 16, 0.6);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }
  /* Phones: the arrows move to the bottom corners, clear of the photo. */
  @media (max-width: 899px) {
    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: max(var(--space-3), env(safe-area-inset-bottom));
      margin-top: 0;
    }
  }
</style>
