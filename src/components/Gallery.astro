---
// Product gallery (spec 5.4): one main picture per photo, only the active one
// shown, and a thumbnail button per photo when there is more than one: a
// column beside the photo from 900 px, dots on the photo on phones (where
// the photo is square, so the name, price and add button fit the first
// screen). gallery.ts switches the picture; arrow keys move between them.
// The first photo is the LCP element of the page: eager, high priority.
import type { ImageMetadata } from 'astro';
import { interpolate } from '../i18n/fallback';
import GalleryScript from './GalleryScript.astro';
import Picture from './Picture.astro';

interface Props {
  images: Array<{ src: string | ImageMetadata; alt: string }>;
  label: string;
  /** "Photo {n} sur {total}" */
  thumbLabel: string;
}
const { images, label, thumbLabel } = Astro.props;
const many = images.length > 1;
---

<div class:list={['gallery', { many }]} data-gallery role="group" aria-label={label}>
  <div class="frame gallery-main">
    {
      images.map((img, i) => (
        <div class="gallery-slide" data-gallery-slide={i} id={`gallery-slide-${i}`} hidden={i > 0}>
          <Picture
            src={img.src}
            alt={img.alt}
            preset="gallery"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
    <slot />
  </div>
  {
    many && (
      <div class="thumbs">
        {images.map((img, i) => (
          <button
            type="button"
            class="thumb"
            data-gallery-thumb={i}
            aria-controls={`gallery-slide-${i}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={interpolate(thumbLabel, { n: i + 1, total: images.length })}
          >
            <Picture src={img.src} alt="" preset="thumb" loading="eager" />
          </button>
        ))}
      </div>
    )
  }
</div>

{many && <GalleryScript />}

<style>
  .gallery {
    position: relative;
  }
  .gallery-main {
    position: relative;
  }
  /* From 900 px the gallery is sticky: the photo never grows taller than the
     screen under the header, so it is always seen whole. */
  @media (min-width: 900px) {
    .gallery-main {
      width: min(100%, calc((100vh - var(--header-h) - 3rem) * 0.8));
    }
    .gallery.many {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      gap: var(--space-4);
      align-items: start;
    }
    .gallery.many .thumbs {
      grid-row: 1;
      grid-column: 1;
      flex-direction: column;
      margin-top: 0;
    }
  }
  .gallery-slide {
    height: 100%;
  }
  .gallery-slide[hidden] {
    display: none;
  }
  .gallery-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .thumbs {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .thumb {
    width: 76px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--kraft);
    border-radius: var(--radius-s);
    background: var(--paper);
    opacity: 0.72;
    touch-action: manipulation;
    transition:
      opacity var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out-strong);
  }
  .thumb:active {
    transform: scale(0.96);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: hover) {
    .thumb:hover {
      opacity: 1;
    }
  }
  .thumb[aria-pressed='true'] {
    border: 2px solid var(--forest);
    opacity: 1;
  }
  /* Phones: a square photo (the pouch sits in its middle) and the thumbnails
     as dots on a cream pill at the bottom of the photo, 28 px targets. */
  @media (max-width: 899px) {
    .gallery-main {
      aspect-ratio: 1 / 1;
    }
    .gallery-slide :global(img) {
      object-position: 50% 52%;
    }
    .thumbs {
      position: absolute;
      bottom: var(--space-3);
      left: 50%;
      gap: 2px;
      margin: 0;
      padding: 0 6px;
      border-radius: var(--radius-pill);
      background: rgba(251, 246, 234, 0.88);
      transform: translateX(-50%);
    }
    .thumb,
    .thumb[aria-pressed='true'] {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      aspect-ratio: auto;
      border: 0;
      border-radius: 50%;
      background: transparent;
      opacity: 1;
    }
    .thumb :global(picture) {
      display: none;
    }
    .thumb::before {
      content: '';
      width: 8px;
      height: 8px;
      border: 1.5px solid var(--forest);
      border-radius: 50%;
      transition: background-color var(--dur-fast) ease;
    }
    .thumb[aria-pressed='true']::before {
      background: var(--forest);
    }
  }
</style>
