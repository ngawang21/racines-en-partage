---
// One product in a grid (spec 5.4 shop): 4:5 framed photo, weight and origin,
// name, review summary when there are reviews, price with the price per kilo,
// stock status when it is not plain "in stock", and the add button of the
// cart contract. The data-* attributes feed shop-filter.ts.
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Product } from '../content/schemas';
import { formatPrice, formatUnitPrice, formatWeight, toCents } from '../i18n/format';
import { routePath } from '../i18n/routing';
import AddToCart from './AddToCart.astro';
import Picture from './Picture.astro';
import ReviewSummary from './ReviewSummary.astro';
import { STOCK_CLASS, stockLabel } from './storefront';

interface Props {
  product: Product;
  locale: Locale;
  t: LocaleContent;
  shopOpen: boolean;
  /** Position in the default ("featured") order, for sorting back. */
  index?: number;
  headingLevel?: 'h2' | 'h3';
  /** Published reviews of the product (reviewStats); nothing shown at count 0. */
  rating?: { count: number; average: number };
}
const { product: p, locale, t, shopOpen, index = 0, headingLevel = 'h3', rating } = Astro.props;
const Heading = headingLevel;
const href = routePath('product', locale, p.slug);
const cents = toCents(p.price);
const weight = formatWeight(p.weightGrams, locale);
---

<article
  class="card lift"
  data-product-card
  data-category={p.category}
  data-price={cents}
  data-name={p.name}
  data-weight={p.weightGrams}
  data-order={index}
  data-featured={p.featured ? '' : undefined}
>
  <div class="frame card-media">
    <Picture src={p.images[0]!} alt="" preset="card" />
    {
      p.stock !== 'in_stock' && (
        <span class:list={['badge', STOCK_CLASS[p.stock], 'card-badge']}>
          {stockLabel(p.stock, t)}
        </span>
      )
    }
  </div>
  <div class="card-body">
    <p class="card-meta">
      <span class="card-weight">{weight}</span>
      <span aria-hidden="true">·</span>
      <span class="card-origin">{p.origin}</span>
    </p>
    <Heading class="card-title">
      <a href={href}>{p.name}</a>
    </Heading>
    {rating && rating.count > 0 && <ReviewSummary stats={rating} {locale} {t} />}
    <div class="card-foot">
      <p class="card-prices">
        <span class="price card-price">{formatPrice(cents, locale)}</span>{' '}
        <span class="card-unit">
          <span class="visually-hidden">{t.shop.unitPrice} </span>
          {formatUnitPrice(cents, p.weightGrams, locale)}
        </span>
      </p>
      <AddToCart
        sku={p.sku}
        stock={p.stock}
        {shopOpen}
        label={t.shop.add}
        outLabel={t.product.stockOut}
        srSuffix={`, ${p.name} ${weight}`}
        icon
        class="card-add"
      />
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-m);
    container-type: inline-size;
  }
  /* Hover: the card rises 2 px, the frame takes the shadow and a deeper
     kraft edge, and the photo eases up a few percent inside its frame. */
  .card-media {
    position: relative;
    isolation: isolate;
    transition:
      box-shadow 320ms var(--ease-out-strong),
      border-color 200ms ease;
  }
  .card-media :global(img) {
    object-position: 50% 60%;
    transition: transform 600ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .card.lift:hover {
      box-shadow: none;
    }
    .card:hover .card-media {
      border-color: var(--kraft-deep);
      box-shadow: var(--shadow-float);
    }
    .card:hover .card-media :global(img) {
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-media :global(img) {
      transition: none;
    }
    .card:hover .card-media :global(img) {
      transform: none;
    }
  }
  .card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--cream);
    box-shadow: var(--shadow-soft);
  }
  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-4) 2px 2px;
  }
  /* One line: a long origin is shortened rather than stranding the dot. The
     product page carries it in full. */
  .card-meta {
    display: flex;
    gap: 6px;
    min-width: 0;
    color: var(--ink-2);
    font-size: var(--fs--1);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .card-meta > * {
    flex: none;
  }
  .card-meta .card-origin {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Narrow cards (two columns on phones): weight and origin on two lines. */
  @container (max-width: 199px) {
    .card-meta {
      flex-direction: column;
      gap: 0;
    }
    .card-meta > [aria-hidden] {
      display: none;
    }
  }
  .card-title {
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem);
    font-weight: 600;
    line-height: 1.25;
  }
  /* The name's link covers the card; the add button sits above it. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-m);
  }
  .card-title a:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .card-title a:focus-visible::after {
    outline: 3px solid var(--hibiscus);
    outline-offset: 4px;
  }
  .card-title a {
    color: var(--forest);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 200ms ease;
  }
  .card:hover .card-title a {
    text-decoration-color: var(--kraft-deep);
  }
  .card-foot {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .card-prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    margin: 0;
  }
  .card-price {
    font-size: var(--fs-2);
    line-height: 1.2;
  }
  .card-unit {
    color: var(--ink-2);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .card-foot :global(.card-add) {
    position: relative;
    z-index: 2;
    min-height: 44px;
    padding-inline: var(--space-4);
    font-size: 0.9375rem;
  }
  .card-foot :global(.card-add svg) {
    width: 18px;
    height: 18px;
  }
  @container (min-width: 230px) {
    .card-foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
