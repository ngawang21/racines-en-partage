---
import { Image } from 'astro:assets';
import medallion from '../assets/brand/medallion.webp';
import { SITE, type Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Settings } from '../content/schemas';
import { interpolate, pickLabel } from '../i18n/fallback';
import { displayPhone } from '../cart/address';
import { phoneE164, whatsappUrl } from '../i18n/format';
import { routePath } from '../i18n/routing';
import Icon from './Icon.astro';
import NewsletterSignup from './forms/NewsletterSignup.astro';

interface Props {
  locale: Locale;
  t: LocaleContent;
  settings: Settings;
  /** Checkout tunnel: no newsletter, no shop links; brand, contact and legal. */
  compact?: boolean;
}
const { locale, t, settings, compact = false } = Astro.props;
const { brand } = settings;
const siret = brand.siret.trim();
// Social pages the owner keeps: round icon links under the tagline.
const socials = [
  { name: 'facebook' as const, href: brand.facebook, label: t.footer.facebook },
  { name: 'instagram' as const, href: brand.instagram, label: t.footer.instagram },
].filter((s) => s.href);
// No postal address here: the shop receives no visitors (legal pages keep it).
const whatsapp = whatsappUrl(brand.whatsapp);
const shopLinks = [
  { href: routePath('shop', locale), label: t.nav.shop },
  { href: routePath('recipes', locale), label: t.footer.recipes },
  { href: routePath('account', locale), label: t.footer.account },
  { href: routePath('lookup', locale), label: t.footer.lookup },
  { href: routePath('about', locale), label: t.nav.about },
  { href: routePath('faq', locale), label: t.nav.faq },
  { href: routePath('contact', locale), label: t.nav.contact },
];
const legalLinks = [
  { href: routePath('legal', locale), label: t.footer.legal },
  { href: routePath('terms', locale), label: t.footer.terms },
  { href: routePath('privacy', locale), label: t.footer.privacy },
];
// The business card page (/carte/, noindex) is the owner's tool, reached by
// its URL (docs/guide-proprietaire.md), not a shopper link.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="kente" aria-hidden="true"></div>
  {
    !compact && settings.newsletter.enabled && (
      <div class="container-wide footer-nl">
        <NewsletterSignup {locale} {t} {settings} variant="footer" />
      </div>
    )
  }
  <div class="container-wide grid">
    <div class="brand-block">
      <a class="brand" href={routePath('home', locale)}>
        <Image src={medallion} alt="" width={56} height={56} densities={[1, 2]} />
        <span class="wordmark">{SITE.name}</span>
      </a>
      <p class="tagline">{pickLabel(brand.tagline, locale)}</p>
      {
        socials.length > 0 && (
          <ul class="socials" role="list">
            {socials.map((s) => (
              <li>
                <a class="social" href={s.href} rel="noopener" target="_blank">
                  <Icon name={s.name} size={22} />
                  <span class="visually-hidden">
                    {interpolate(t.footer.followOn, { network: s.label })} {t.a11y.newTab}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {siret && <p class="siret">SIRET {siret}</p>}
    </div>

    <div class="contact-block">
      <h2 class="col-title">{t.footer.contactTitle}</h2>
      <ul role="list" class="links contact">
        <li>
          <a href={`tel:${phoneE164(brand.phone)}`}>
            <Icon name="phone" size={18} />
            <span>{displayPhone(brand.phone, locale)}</span>
          </a>
        </li>
        {
          whatsapp && (
            <li>
              <a href={whatsapp} rel="noopener" target="_blank" data-footer-whatsapp>
                <Icon name="whatsapp" size={18} />
                <span>{t.footer.whatsappCta}</span>
                <span class="visually-hidden">{t.a11y.newTab}</span>
              </a>
            </li>
          )
        }
        <li>
          <a href={`mailto:${brand.email}`}>
            <Icon name="mail" size={18} />
            <span>{brand.email}</span>
          </a>
        </li>
      </ul>
    </div>

    {
      !compact && (
        <nav aria-label={t.footer.shopTitle}>
          <h2 class="col-title">{t.footer.shopTitle}</h2>
          <ul role="list" class="links">
            {shopLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav aria-label={t.footer.infoTitle}>
      <h2 class="col-title">{t.footer.infoTitle}</h2>
      <ul role="list" class="links">
        {
          legalLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="container-wide bottom">
    <p>{interpolate(t.footer.copyright, { year })}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    background: var(--forest);
    color: var(--cream);
  }
  /* A page that ends on a coloured band meets the kente strip directly. */
  :global(main:has(> :last-child:is(.band-paper, .band-forest))) + .site-footer {
    margin-top: 0;
  }
  /* Phones: brand and contact full width, the two link lists side by side. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-4);
    padding-block: var(--space-12);
  }
  @media (max-width: 699px) {
    .brand-block,
    .contact-block {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: 1.4fr 1.2fr 1fr 1fr;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border-radius: var(--radius-s);
    color: var(--cream);
    text-decoration: none;
  }
  .brand img {
    width: 56px;
    height: 56px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: 'SOFT' 50;
    font-size: 1.375rem;
    font-weight: 600;
  }
  .tagline {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-1);
    max-width: 28ch;
  }
  .socials {
    display: flex;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
  }
  .social {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(251, 246, 234, 0.28);
    border-radius: 50%;
    color: var(--cream);
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      transform var(--dur-press) var(--ease-out-strong);
  }
  .social:active {
    transform: scale(0.96);
  }
  @media (hover: hover) {
    .social:hover {
      border-color: var(--gold);
      background: rgba(251, 246, 234, 0.08);
    }
  }
  .siret {
    margin-top: var(--space-3);
    color: var(--cream-muted);
    font-size: var(--fs--1);
    font-variant-numeric: tabular-nums;
  }
  .col-title {
    margin-bottom: var(--space-3);
    color: var(--cream);
    font-family: var(--font-body);
    font-size: var(--fs--1);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .links {
    margin: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    color: var(--cream-muted);
    line-height: 1.35;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color var(--dur-fast) ease,
      text-decoration-color var(--dur-fast) ease;
  }
  @media (hover: hover) {
    .links a:hover {
      color: var(--cream);
      text-decoration-color: var(--gold);
    }
  }
  .footer-nl {
    padding-block: var(--space-12) 0;
  }
  .footer-nl + .grid {
    margin-top: var(--space-12);
    border-top: 1px solid rgba(251, 246, 234, 0.14);
  }
  /* A page with its own newsletter band (recipes, the newsletter landing
     page) shows no second signup here. */
  :global(body:has(main .nl-band)) .footer-nl {
    display: none;
  }
  :global(body:has(main .nl-band)) .footer-nl + .grid {
    margin-top: 0;
    border-top: 0;
  }
  .contact a span:not(.visually-hidden) {
    overflow-wrap: anywhere;
  }
  .contact :global(svg) {
    flex: none;
    color: var(--gold);
  }
  .bottom {
    padding-block: var(--space-6);
    border-top: 1px solid rgba(251, 246, 234, 0.14);
    color: var(--cream-muted);
    font-size: var(--fs--1);
  }
  .site-footer :focus-visible {
    box-shadow: 0 0 0 2px var(--forest);
  }
</style>
