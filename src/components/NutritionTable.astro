---
// Nutrition facts per 100 g, values as printed on the label. Rendered only
// when the product's nutritionVerified flag is true (the page decides).
import type { Locale } from '../consts';
import type { LocaleContent } from '../content/locale-schema';
import type { Nutrition } from '../content/schemas';
import { localiseNutrition } from '../i18n/format';

interface Props {
  nutrition: Nutrition;
  locale: Locale;
  t: LocaleContent;
}
const { nutrition, locale, t } = Astro.props;
const rows: Array<{ key: keyof Nutrition; sub?: boolean }> = [
  { key: 'energy' },
  { key: 'fat' },
  { key: 'saturates', sub: true },
  { key: 'carbs' },
  { key: 'sugars', sub: true },
  { key: 'fibre' },
  { key: 'protein' },
  { key: 'salt' },
];
---

<table class="nutrition">
  <caption class="visually-hidden">{t.product.nutrition}, {t.product.nutritionPer}</caption>
  <thead>
    <tr>
      <th scope="col"><span class="visually-hidden">{t.product.nutrition}</span></th>
      <th scope="col" class="per">{t.product.nutritionPer}</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr class:list={{ sub: r.sub }}>
          <th scope="row">{t.product[r.key]}</th>
          <td>{localiseNutrition(nutrition[r.key], locale)}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .nutrition {
    width: 100%;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  td,
  .per {
    text-align: right;
  }
  thead th {
    padding-top: 0;
    color: var(--ink-2);
    font-size: var(--fs--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  tbody th {
    font-weight: 500;
  }
  .sub th {
    padding-left: var(--space-4);
    color: var(--ink-2);
    font-weight: 400;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
