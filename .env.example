# Site build variables (Astro reads PUBLIC_* at build time). Copy to .env for
# local builds; in Cloudflare Workers Builds set them as build variables.

# Mondial Relay Parcel Shop Picker brand code. BDTEST is the public demo
# account (the widget shows a red "compte de démonstration" line); set the
# "Offre Start" client code in production.
PUBLIC_MONDIAL_RELAY_BRAND=BDTEST
