# Copy to .dev.vars (git ignored) for `pnpm dev:worker`. Test-mode values only.

# Stripe secret key, test mode first (Dashboard, Developers, API keys).
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret of the webhook endpoint. Locally: `stripe listen --forward-to
# localhost:8787/api/webhooks/stripe` prints a whsec_ value.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. Without it the Worker logs a redacted summary instead of sending e-mails.
RESEND_API_KEY=

# Owner inbox for order e-mails (also the reply-to of customer e-mails).
ORDER_EMAIL_TO=racinesenpartage@gmail.com

# Overrides the wrangler.jsonc value so Stripe redirects back to the local server.
SITE_URL=http://localhost:8787

# Signs the review and newsletter links. Generate with `openssl rand -base64 32`.
# FORMS_SECRET=

# Fine-grained GitHub token (Contents read and write on this repository only);
# needed by POST /api/reviews. Leave unset locally unless testing reviews.
# GITHUB_TOKEN=

# Turnstile secret; set it only together with the site key in the CMS
# settings, or every form fails. Without it the contact and newsletter forms
# answer 404 unless FORMS_ALLOW_WITHOUT_CAPTCHA is true.
# TURNSTILE_SECRET_KEY=

# Local development only: lets the forms work without Turnstile. NEVER set it
# in the Cloudflare dashboard or in wrangler.jsonc (bots could spend the
# Resend quota the order e-mails need).
# FORMS_ALLOW_WITHOUT_CAPTCHA=true

# Resend audience of the newsletter; unset disables the newsletter endpoints.
# RESEND_AUDIENCE_ID=
