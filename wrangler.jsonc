// Cloudflare Worker: static assets from dist/ plus the API in worker/ on /api/*.
// Secrets (never in this file): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
// RESEND_API_KEY (optional), ORDER_EMAIL_TO, FORMS_SECRET, GITHUB_TOKEN,
// TURNSTILE_SECRET_KEY (the forms are off without it), RESEND_AUDIENCE_ID (optional).
// Local values go in .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racines-en-partage",
  "main": "worker/index.ts",
  // The *.workers.dev address (the default, workers_dev true) serves the whole
  // shop, /api/* included. It stays on until the custom domain serves and the
  // go-live order passed, then "workers_dev": false is added here
  // (docs/deployment.md, section 5, step 4; launch runbook phase K).
  // Newest date the workerd bundled with wrangler 4.156 supports (dev refuses later ones).
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "SITE_URL": "https://racinesenpartage.fr",
    "ORDER_EMAIL_FROM": "Racines en Partage <commandes@racinesenpartage.fr>",
    // Repository the review files are committed to (POST /api/reviews).
    "GITHUB_REPO": "ngawang21/racines-en-partage",
    // Daily ceiling of e-mails sent by the contact, stock-alert and newsletter
    // forms (counted in FORMS_KV when it is bound).
    "FORMS_DAILY_LIMIT": "60",
  },
  // Daily form budget (worker/budget.ts). Optional: without the binding no
  // budget applies. It keeps form spam from eating the Resend quota the order
  // e-mails need. Create the namespace (docs/deployment.md, section 18), then
  // uncomment with its id; a deploy with a placeholder id would fail.
  // "kv_namespaces": [{ "binding": "FORMS_KV", "id": "<id of the FORMS_KV namespace>" }],
  // Per-IP limits (worker/app.ts), keyed on CF-Connecting-IP: checkout; the
  // order page and the order lookup; the contact, newsletter and review forms.
  // Free; namespace_id is any integer unique to the account.
  "ratelimits": [
    { "name": "CHECKOUT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ORDERS_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "FORMS_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
  ],
  // Review invitations, every day at 09:00 UTC (10:00 or 11:00 in Paris). They
  // also stop when reviews are turned off in the CMS settings; removing this
  // block stops the run itself (docs/deployment.md, section 17).
  "triggers": { "crons": ["0 9 * * *"] },
  "observability": { "enabled": true },
}
