// Cloudflare Worker: static assets from dist/ plus the API in worker/ on /api/*.
// Secrets (never in this file): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
// RESEND_API_KEY (optional), ORDER_EMAIL_TO. Local values go in .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racines-en-partage",
  "main": "worker/index.ts",
  // Newest date the workerd bundled with wrangler 4.156 supports (dev refuses later ones).
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "SITE_URL": "https://racinesenpartage.fr",
    "ORDER_EMAIL_FROM": "Racines en Partage <commandes@racinesenpartage.fr>",
  },
  // Per-IP limits on POST /api/checkout and GET /api/orders/:id (worker/app.ts),
  // keyed on CF-Connecting-IP. Free; namespace_id is any integer unique to the account.
  "ratelimits": [
    { "name": "CHECKOUT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ORDERS_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
